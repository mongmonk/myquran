7.mp3","juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"verseId":48,"ayahText":"\u0648\u064e\u064a\u064f\u0639\u064e\u0644\u0651\u0650\u0645\u064f\u0647\u064f \u0627\u0644\u0652\u0643\u0650\u062a\u0670\u0628\u064e \u0648\u064e\u0627\u0644\u0652\u062d\u0650\u0643\u0652\u0645\u064e\u0629\u064e \u0648\u064e\u0627\u0644\u062a\u0651\u064e\u0648\u0652\u0631\u0670\u0649\u0629\u064e \u0648\u064e\u0627\u0644\u0652\u0627\u0650\u0646\u0652\u062c\u0650\u064a\u0652\u0644\u064e\u06da","indoText":"Dan Dia (Allah) mengajarkan kepadanya (Isa) Kitab, Hikmah, Taurat, dan Injil.","enText":"And He will teach him writing and wisdom and the Torah and the Gospel","readText":"wa yu'allimuhul-kit\u0101ba wal-\u1e25ikmata wat-taur\u0101ta wal-inj\u012bl","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/003048.mp3","juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"verseId":49,"ayahText":"\u0648\u064e\u0631\u064e\u0633\u064f\u0648\u0652\u0644\u064b\u0627 \u0627\u0650\u0644\u0670\u0649 \u0628\u064e\u0646\u0650\u064a\u0652\u0653 \u0627\u0650\u0633\u0652\u0631\u064e\u0627\u06e4\u0621\u0650\u064a\u0652\u0644\u064e \u06d5\u06d9 \u0627\u064e\u0646\u0651\u0650\u064a\u0652 \u0642\u064e\u062f\u0652 \u062c\u0650\u0626\u0652\u062a\u064f\u0643\u064f\u0645\u0652 \u0628\u0650\u0627\u0670\u064a\u064e\u0629\u064d \u0645\u0650\u0651\u0646\u0652 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u0652 \u06d9\u0627\u064e\u0646\u0651\u0650\u064a\u0652\u0653 \u0627\u064e\u062e\u0652\u0644\u064f\u0642\u064f \u0644\u064e\u0643\u064f\u0645\u0652 \u0645\u0651\u0650\u0646\u064e \u0627\u0644\u0637\u0651\u0650\u064a\u0652\u0646\u0650 \u0643\u064e\u0647\u064e\u064a\u0652\u0640\u0654\u064e\u0629\u0650 \u0627\u0644\u0637\u0651\u064e\u064a\u0652\u0631\u0650 \u0641\u064e\u0627\u064e\u0646\u0652\u0641\u064f\u062e\u064f \u0641\u0650\u064a\u0652\u0647\u0650 \u0641\u064e\u064a\u064e\u0643\u064f\u0648\u0652\u0646\u064f \u0637\u064e\u064a\u0652\u0631\u064b\u0627\u06e2 \u0628\