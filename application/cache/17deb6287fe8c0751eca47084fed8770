u0650\u0644\u064e\u0649 \u0627\u0644\u0652\u0647\u064f\u062f\u0670\u0649 \u0644\u064e\u0627 \u064a\u064e\u0633\u0652\u0645\u064e\u0639\u064f\u0648\u0652\u0627\u06d7 \u0648\u064e\u062a\u064e\u0631\u0670\u0649\u0647\u064f\u0645\u0652 \u064a\u064e\u0646\u0652\u0638\u064f\u0631\u064f\u0648\u0652\u0646\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0643\u064e \u0648\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u064a\u064f\u0628\u0652\u0635\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan jika kamu menyeru mereka (berhala-berhala) untuk memberi petunjuk, mereka tidak dapat mendengarnya. Dan kamu lihat mereka memandangmu padahal mereka tidak melihat.","enText":"And if you invite them to guidance, they do not hear; and you see them looking at you while they do not see.","readText":"wa in tad'\u1ee5hum ilal-hud\u0101 l\u0101 yasma'\u1ee5, wa tar\u0101hum yan\u1e93ur\u1ee5na ilaika wa hum l\u0101 yub\u1e63ir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007198.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":199,"ayahText":"\u062e\u064f\u0630\u0650 \u0627\u0644\u0652\u0639\u064e\u0641\u0652\u0648\u064e \u0648\u064e\u0623\u0652\u0645\u064f\u0631\u0652 \u0628\u0650\u0627\u0644\u0652\u0639\u064f\u0631\u0652\u0641\u0650 \u0648\u064e\u0627\u064e\u0639\u0652\u0631\u0650\u0636\u0652 \u0639\u064e\u0646\u0650 \u0627\u0644\u0652\u062c\u064e\u0627\u0647\u0650\u0644\u0650\u064a\u0652\u0646\u064e","indoText":"Jadilah pemaaf dan suruhlah orang mengerjakan yang makruf, serta jangan pedulikan orang-orang yang bodoh.","enText":"Take what is given freely, enjoin what is good, and turn away from the ignorant.","readText":"khu\u017cil-'afwa wa`mur bil-'urfi wa a'ri\u1e0d 'anil-j\u0101hil\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007199.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":200,"ayahText":"\u0648\u064e\u0627\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0646\u0652\u0632\u064e\u063a\u064e\u0646\u0651\u064e\u0643\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0634\u0651\u064e\u064a\u0652\u0637\u0670\u0646\u0650 \u0646\u064e\u0632\u0652\u063a\u064c \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0639\u0650\u0630\u0652 \u0628\u0650\u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u06d7\u0627\u0650\u0646\u0651\u064e\u0647\u0657 \u0633\u064e\u0645\u0650\u064a\u0652\u0639\u064c \u0639\u064e\u0644\u0650\u064a\u0652\u0645\u064c","indoText":"Dan jika setan datang menggodamu, maka berlindunglah kepada Allah. Sungguh, Dia Maha Mendengar, Maha Mengetahui.","enText":"And if an evil suggestion comes to you from Satan, then seek refuge in Allah. Indeed, He is Hearing and Knowing.","readText":"wa imm\u0101 yanzagannaka minasy-syai\u1e6d\u0101ni nazgun fasta'i\u017c bill\u0101h, innah\u1ee5 sam\u012b'un 'al\u012bm","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007200.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":201,"ayahText":"\u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u062a\u0651\u064e\u0642\u064e\u0648\u0652\u0627 \u0627\u0650\u0630\u064e\u0627 \u0645\u064e\u0633\u0651\u064e\u0647\u064f\u0645\u0652 \u0637\u0670\u06e4\u0649\u0655\u0650\u0641\u064c \u0645\u0651\u0650\u0646\u064e \u0627\u0644\u0634\u0651\u064e\u064a\u0652\u0637\u0670\u0646\u0650 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0652\u0627 \u0641\u064e\u0627\u0650\u0630\u064e\u0627 \u0647\u064f\u0645\u0652 \u0645\u0651\u064f\u0628\u0652\u0635\u0650\u0631\u064f\u0648\u0652\u0646\u064e\u06da","indoText":"Sesungguhnya orang-orang yang bertakwa apabila mereka dibayang-bayangi pikiran jahat (berbuat dosa) dari setan, mereka pun segera ingat kepada Allah, maka ketika itu juga mereka melihat (kesalahan-kesalahannya).","enText":"Indeed, those who fear Allah - when an impulse touches them from Satan, they remember [Him] and at once they have insight.","readText":"innalla\u017c\u012bnattaqau i\u017c\u0101 massahum \u1e6d\u0101`ifum minasy-syai\u1e6d\u0101ni ta\u017cakkar\u1ee5 fa i\u017c\u0101 hum mub\u1e63ir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007201.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":202,"ayahText":"\u0648\u064e\u0627\u0650\u062e\u0652\u0648\u064e\u0627\u0646\u064f\u0647\u064f\u0645\u0652 \u064a\u064e\u0645\u064f\u062f\u0651\u064f\u0648\u0652\u0646\u064e\u0647\u064f\u0645\u0652 \u0641\u0650\u0649 \u0627\u0644\u0652\u063a\u064e\u064a\u0651\u0650 \u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u0642\u0652\u0635\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan teman-teman mereka (orang kafir dan fasik) membantu setan-setan dalam menyesatkan dan mereka tidak henti-hentinya (menyesatkan).","enText":"But their brothers - the devils increase them in error; then they do not stop short.","readText":"wa ikhw\u0101nuhum yamudd\u1ee5nahum fil-gayyi \u1e61umma l\u0101 yuq\u1e63ir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007202.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":203,"ayahText":"\u0648\u064e\u0627\u0650\u0630\u064e\u0627 \u0644\u064e\u0645\u0652 \u062a\u064e\u0623\u0652\u062a\u0650\u0647\u0650\u0645\u0652 \u0628\u0650\u0627\u0670\u064a\u064e\u0629\u064d \u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0627 \u0644\u064e\u0648\u0652\u0644\u064e\u0627 \u0627\u062c\u0652\u062a\u064e\u0628\u064e\u064a\u0652\u062a\u064e\u0647\u064e\u0627\u06d7 \u0642\u064f\u0644\u0652 \u0627\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0627\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f \u0645\u064e\u0627 \u064a\u064f\u0648\u0652\u062d\u0670\u0653\u0649 \u0627\u0650\u0644\u064e\u064a\u0651\u064e \u0645\u0650\u0646\u0652 \u0631\u0651\u064e\u0628\u0651\u0650\u064a\u0652\u06d7 \u0647\u0670\u0630\u064e\u0627 \u0628\u064e\u0635\u064e\u0627\u06e4\u0649\u0655\u0650\u0631\u064f \u0645\u0650\u0646\u0652 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0647\u064f\u062f\u064b\u0649 \u0648\u0651\u064e\u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064c \u0644\u0651\u0650\u0642\u064e\u0648\u0652\u0645\u064d \u064a\u0651\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0652\u0646\u064e","indoText":"Dan apabila engkau (Muhammad) tidak membacakan suatu ayat kepada mereka, mereka berkata, \u201cMengapa tidak engkau buat sendiri ayat itu?\u201d Katakanlah (Muhammad), \u201cSesungguhnya aku hanya mengikuti apa yang diwahyukan Tuhanku kepadaku. (Al-Qur'an) ini adalah bukti-bukti yang nyata dari Tuhanmu, petunjuk dan rahmat bagi orang-orang yang beriman.\u201d","enText":"And when you, [O Muhammad], do not bring them a sign, they say, \"Why have you not contrived it?\" Say, \"I only follow what is revealed to me from my Lord. This [Qur'an] is enlightenment from your Lord and guidance and mercy for a people who believe.\"","readText":"wa i\u017c\u0101 lam ta`tihim bi`\u0101yating q\u0101l\u1ee5 lau lajtabaitah\u0101, qul innam\u0101 attabi'u m\u0101 y\u1ee5\u1e25\u0101 ilayya mir rabb\u012b, h\u0101\u017c\u0101 ba\u1e63\u0101`iru mir rabbikum wa hudaw wa ra\u1e25matul liqaumiy yu`min\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007203.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":204,"ayahText":"\u0648\u064e\u0627\u0650\u0630\u064e\u0627 \u0642\u064f\u0631\u0650\u0626\u064e \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u064f \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0645\u0650\u0639\u064f\u0648\u0652\u0627 \u0644\u064e\u0647\u0657 \u0648\u064e\u0627\u064e\u0646\u0652\u0635\u0650\u062a\u064f\u0648\u0652\u0627 \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u062a\u064f\u0631\u0652\u062d\u064e\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"Dan apabila dibacakan Al-Qur'an, maka dengarkanlah dan diamlah, agar kamu mendapat rahmat.","enText":"So when the Qur'an is recited, then listen to it and pay attention that you may receive mercy.","readText":"wa i\u017c\u0101 quri`al-qur`\u0101nu fastami'\u1ee5 lah\u1ee5 wa an\u1e63it\u1ee5 la'allakum tur-\u1e25am\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007204.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":205,"ayahText":"\u0648\u064e\u0627\u0630\u0652\u0643\u064f\u0631\u0652 \u0631\u0651\u064e\u0628\u0651\u064e\u0643\u064e \u0641\u0650\u064a\u0652 \u0646\u064e\u0641\u0652\u0633\u0650\u0643\u064e \u062a\u064e\u0636\u064e\u0631\u0651\u064f\u0639\u064b\u0627 \u0648\u0651\u064e\u062e\u0650\u064a\u0652\u0641\u064e\u0629\u064b \u0648\u0651\u064e\u062f\u064f\u0648\u0652\u0646\u064e \u0627\u0644\u0652\u062c\u064e\u0647\u0652\u0631\u0650 \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0642\u064e\u0648\u0652\u0644\u0650 \u0628\u0650\u0627\u0644\u0652\u063a\u064f\u062f\u064f\u0648\u0651\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u0670\u0635\u064e\u0627\u0644\u0650 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0643\u064f\u0646\u0652 \u0645\u0651\u0650\u0646\u064e \u0627\u0644\u0652\u063a\u0670\u0641\u0650\u0644\u0650\u064a\u0652\u0646\u064e","indoText":"Dan ingatlah Tuhanmu dalam hatimu dengan rendah hati dan rasa takut, dan dengan tidak mengeraskan suara, pada waktu pagi dan petang, dan janganlah kamu termasuk orang-orang yang lengah.","enText":"And remember your Lord within yourself in humility and in fear without being apparent in speech - in the mornings and the evenings. And do not be among the heedless.","readText":"wa\u017ckur rabbaka f\u012b nafsika ta\u1e0darru'aw wa kh\u012bfataw wa d\u1ee5nal-jahri minal-qauli bil-guduwwi wal-\u0101\u1e63\u0101li wa l\u0101 takum minal-g\u0101fil\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007205.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"verseId":206,"ayahText":"\u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0639\u0650\u0646\u0652\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0644\u064e\u0627 \u064a\u064e\u0633\u0652\u062a\u064e\u0643\u0652\u0628\u0650\u0631\u064f\u0648\u0652\u0646\u064e \u0639\u064e\u0646\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u064e\u062a\u0650\u0647\u0656 \u0648\u064e\u064a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f\u0648\u0652\u0646\u064e\u0647\u0657 \u0648\u064e\u0644\u064e\u0647\u0657 \u064a\u064e\u0633\u0652\u062c\u064f\u062f\u064f\u0648\u0652\u0646\u064e \u06e9","indoText":"Sesungguhnya orang-orang yang ada di sisi Tuhanmu tidak merasa enggan untuk menyembah Allah dan mereka menyucikan-Nya dan hanya kepada-Nya mereka bersujud.","enText":"Indeed, those who are near your Lord are not prevented by arrogance from His worship, and they exalt Him, and to Him they prostrate.","readText":"innalla\u017c\u012bna 'inda rabbika l\u0101 yastakbir\u1ee5na 'an 'ib\u0101datih\u012b wa yusabbi\u1e25\u1ee5nah\u1ee5 wa lah\u1ee5 yasjud\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/007206.mp3","juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":true}]}";}