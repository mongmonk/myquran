a:3:{s:4:"time";i:1674133862;s:3:"ttl";i:31536000;s:4:"data";s:84164:"{"translationId":"Bangsa Romawi","translationEn":"The Romans","asma":"\u0627\u0644\u0631\u0648\u0645","numberOfAyahs":60,"name":"Ar Ruum","number":30,"typeId":"mekah","typeEn":"Meccan","orderNumber":84,"ayahs":[{"verseId":1,"ayahText":" \u0627\u0644\u06e4\u0645\u06e4\u0651 \u06da","indoText":"Alif Lam Mim.","enText":"Alif, Lam, Meem.","readText":"alif l\u0101m m\u012bm","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030001.mp3","juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":2,"ayahText":"\u063a\u064f\u0644\u0650\u0628\u064e\u062a\u0650 \u0627\u0644\u0631\u0651\u064f\u0648\u0652\u0645\u064f\u06d9","indoText":"Bangsa Romawi telah dikalahkan,","enText":"The Byzantines have been defeated","readText":"gulibatir-r\u1ee5m","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030002.mp3","juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":3,"ayahText":"\u0641\u0650\u064a\u0652\u0653 \u0627\u064e\u062f\u0652\u0646\u064e\u0649 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0647\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652\u06e2 \u0628\u064e\u0639\u0652\u062f\u0650 \u063a\u064e\u0644\u064e\u0628\u0650\u0647\u0650\u0645\u0652 \u0633\u064e\u064a\u064e\u063a\u0652\u0644\u0650\u0628\u064f\u0648\u0652\u0646\u064e\u06d9","indoText":"di negeri yang terdekat dan mereka setelah kekalahannya itu akan menang,","enText":"In the nearest land. But they, after their defeat, will overcome.","readText":"f\u012b adnal-ar\u1e0di wa hum mim ba'di galabihim sayaglib\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030003.mp3","juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":4,"ayahText":"\u0641\u0650\u064a\u0652 \u0628\u0650\u0636\u0652\u0639\u0650 \u0633\u0650\u0646\u0650\u064a\u0652\u0646\u064e \u06d5\u06d7 \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0652\u0627\u064e\u0645\u0652\u0631\u064f \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u064f \u0648\u064e\u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u0639\u0652\u062f\u064f \u06d7\u0648\u064e\u064a\u064e\u0648\u0652\u0645\u064e\u0649\u0655\u0650\u0630\u064d \u064a\u0651\u064e\u0641\u0652\u0631\u064e\u062d\u064f \u0627\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0652\u0646\u064e\u06d9","indoText":"dalam beberapa tahun (lagi). Bagi Allah-lah urusan sebelum dan setelah (mereka menang). Dan pada hari (kemenangan bangsa Romawi) itu bergembiralah orang-orang yang beriman,","enText":"Within three to nine years. To Allah belongs the command before and after. And that day the believers will rejoice","readText":"f\u012b bi\u1e0d'i sin\u012bn, lill\u0101hil-amru ming qablu wa mim ba'd, wa yauma`i\u017ciy yafra\u1e25ul-mu`min\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030004.mp3","juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":5,"ayahText":"\u0628\u0650\u0646\u064e\u0635\u0652\u0631\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u06d7\u064a\u064e\u0646\u0652\u0635\u064f\u0631\u064f \u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u0634\u064e\u0627\u06e4\u0621\u064f\u06d7 \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0652\u0632\u064f \u0627\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0652\u0645\u064f","indoText":"karena pertolongan Allah. Dia menolong siapa yang Dia kehendaki. Dia Mahaperkasa, Maha Penyayang.","enText":"In the victory of Allah. He gives victory to whom He wills, and He is the Exalted in Might, the Merciful.","readText":"bina\u1e63rill\u0101h, yan\u1e63uru may yasy\u0101`, wa huwal-'az\u012bzur-ra\u1e25\u012bm","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030005.mp3","juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":6,"ayahText":"\u0648\u064e\u0639\u0652\u062f\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u06d7 \u0644\u064e\u0627 \u064a\u064f\u062e\u0652\u0644\u0650\u0641\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0648\u064e\u0639\u0652\u062f\u064e\u0647\u0657 \u0648\u064e\u0644\u0670\u0643\u0650\u0646\u0651\u064e \u0627\u064e\u0643\u0652\u062b\u064e\u0631\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"(Itulah) janji Allah. Allah tidak akan menyalahi janji-Nya, tetapi kebanyakan manusia tidak mengetahui.","enText":"[It is] the promise of Allah. Allah does not fail in His promise, but most of the people do not know.","readText":"wa'dall\u0101h, l\u0101 yukhlifull\u0101hu wa'dah\u1ee5 wa l\u0101kinna ak\u1e61aran-n\u0101si l\u0101 ya'lam\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030006.mp3","juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":7,"ayahText":"\u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0652\u0646\u064e \u0638\u064e\u0627\u0647\u0650\u0631\u064b\u0627 \u0645\u0650\u0651\u0646\u064e \u0627\u0644\u0652\u062d\u064e\u064a\u0670\u0648\u0629\u0650 \u0627\u0644\u062f\u0651\u064f\u0646\u0652\u064a\u064e\u0627\u06d6 \u0648\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0646\u0650 \u0627\u0644\u0652\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u0647\u064f\u0645\u0652 \u063a\u0670\u0641\u0650\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Mereka mengetahui yang lahir (tampak) dari kehidupan dunia; sedangkan terhadap (kehidupan) akhirat mereka lalai.","enText":"They know what is apparent of the worldly life, but they, of the Hereafter, are unaware.","readText":"ya'lam\u1ee5na \u1e93\u0101hiram minal-\u1e25ay\u0101tid-dun-y\u0101 wa hum 'anil-\u0101khirati hum g\u0101fil\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030007.mp3","juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":8,"ayahText":"\u0627\u064e\u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0652\u0627 \u0641\u0650\u064a\u0652\u0653 \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u0650\u0647\u0650\u0645\u0652 \u06d7 \u0645\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u064e\u0627\u0653 \u0627\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0648\u064e\u0627\u064e\u062c\u064e\u0644\u064d \u0645\u0651\u064f\u0633\u064e\u0645\u0651\u064b\u0649\u06d7 \u0648\u064e\u0627\u0650\u0646\u0651\u064e \u0643\u064e\u062b\u0650\u064a\u0652\u0631\u064b\u0627 \u0645\u0650\u0651\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u0628\u0650\u0644\u0650\u0642\u064e\u0627\u06e4\u0626\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u0652 \u0644\u064e\u0643\u0670\u0641\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan mengapa mereka tidak memikirkan tentang (kejadian) diri mereka? Allah tidak menciptakan langit dan bumi dan apa yang ada di antara keduanya melainkan dengan (tujuan) yang benar dan dalam waktu yang ditentukan. Dan sesungguhnya kebanyakan di antara manusia benar-benar mengingkari pertemuan dengan Tuhannya.","enText":"Do they not contemplate within themselves? Allah has not created the heavens and the earth and what is between them except in truth and for a specified term. And indeed, many of the people, in [the matter of] the meeting with their Lord, are disbelievers.","readText":"a wa lam yatafakkar\u1ee5 f\u012b anfusihim, m\u0101 khalaqall\u0101hus-sam\u0101w\u0101ti wal-ar\u1e0da wa m\u0101 bainahum\u0101 ill\u0101 bil-\u1e25aqqi wa ajalim musamm\u0101, wa inna ka\u1e61\u012bram minan-n\u0101si biliq\u0101`i rabbihim lak\u0101fir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030008.mp3","juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":9,"ayahText":"\u0627\u064e\u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0633\u0650\u064a\u0652\u0631\u064f\u0648\u0652\u0627 \u0641\u0650\u0649 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0641\u064e\u064a\u064e\u0646\u0652\u0638\u064f\u0631\u064f\u0648\u0652\u0627 \u0643\u064e\u064a\u0652\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0627\u0642\u0650\u0628\u064e\u0629\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650\u0647\u0650\u0645\u0652\u06d7 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0653\u0627 \u0627\u064e\u0634\u064e\u062f\u0651\u064e \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0642\u064f\u0648\u0651\u064e\u0629\u064b \u0648\u0651\u064e\u0627\u064e\u062b\u064e\u0627\u0631\u064f\u0648\u0627 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0648\u064e\u0639\u064e\u0645\u064e\u0631\u064f\u0648\u0652\u0647\u064e\u0627\u0653 \u0627\u064e\u0643\u0652\u062b\u064e\u0631\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u0639\u064e\u0645\u064e\u0631\u064f\u0648\u0652\u0647\u064e\u0627 \u0648\u064e\u062c\u064e\u0627\u06e4\u0621\u064e\u062a\u0652\u0647\u064f\u0645\u0652 \u0631\u064f\u0633\u064f\u0644\u064f\u0647\u064f\u0645\u0652 \u0628\u0650\u0627\u0644\u0652\u0628\u064e\u064a\u0651\u0650\u0646\u0670\u062a\u0650\u06d7 \u0641\u064e\u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0644\u0650\u064a\u064e\u0638\u0652\u0644\u0650\u0645\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0644\u0670\u0643\u0650\u0646\u0652 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0653\u0627 \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0638\u0652\u0644\u0650\u0645\u064f\u0648\u0652\u0646\u064e\u06d7","indoText":"Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul)? Orang-orang itu lebih kuat dari mereka (sendiri) dan mereka telah mengolah bumi (tanah) serta memakmurkannya melebihi apa yang telah mereka makmurkan. Dan telah datang kepada mereka rasul-rasul mereka dengan membawa bukti-bukti yang jelas. Maka Allah sama sekali tidak berlaku zalim kepada mereka, tetapi merekalah yang berlaku zalim kepada diri mereka sendiri.","enText":"Have they not traveled through the earth and observed how was the end of those before them? They were greater than them in power, and they plowed the earth and built it up more than they have built it up, and their messengers came to them with clear evidences. And Allah would not ever have wronged them, but they were wronging themselves.","readText":"a wa lam yas\u012br\u1ee5 fil-ar\u1e0di fa yan\u1e93ur\u1ee5 kaifa k\u0101na '\u0101qibatulla\u017c\u012bna ming qablihim, k\u0101n\u016b asyadda min-hum quwwataw wa a\u1e61\u0101rul-ar\u1e0da wa 'amar\u1ee5h\u0101 ak\u1e61ara mimm\u0101 'amar\u1ee5h\u0101 wa j\u0101`at-hum rusuluhum bil-bayyin\u0101t, fa m\u0101 k\u0101nall\u0101hu liya\u1e93limahum wa l\u0101king k\u0101n\u016b anfusahum ya\u1e93lim\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030009.mp3","juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":10,"ayahText":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0627\u0642\u0650\u0628\u064e\u0629\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u064e\u0633\u064e\u0627\u06e4\u0621\u064f\u0648\u0627 \u0627\u0644\u0633\u0651\u064f\u0648\u0652\u06e4\u0627\u0670\u0649\u0653 \u0627\u064e\u0646\u0652 \u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0652\u0627 \u0628\u0650\u0627\u0670\u064a\u0670\u062a\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0628\u0650\u0647\u064e\u0627 \u064a\u064e\u0633\u0652\u062a\u064e\u0647\u0652\u0632\u0650\u0621\u064f\u0648\u0652\u0646\u064e","indoText":"Kemudian, azab yang lebih buruk adalah kesudahan bagi orang-orang yang mengerjakan kejahatan. Karena mereka mendustakan ayat-ayat Allah dan mereka selalu memperolok-olokkannya.","enText":"Then the end of those who did evil was the worst [consequence] because they denied the signs of Allah and used to ridicule them.","readText":"\u1e61umma k\u0101na '\u0101qibatalla\u017c\u012bna as\u0101`us-s\u016b`\u0101 ang ka\u017c\u017cab\u1ee5 bi`\u0101y\u0101till\u0101hi wa k\u0101n\u1ee5 bih\u0101 yastahzi`\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030010.mp3","juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"verseId":11,"ayahText":"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u064a\u064e\u0628\u0652\u062f\u064e\u0624\u064f\u0627 \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u064e \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0639\u0650\u064a\u0652\u062f\u064f\u0647\u0657 \u062b\u064f\u0645\u0651\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u062a\u064f\u0631\u0652\u062c\u064e\u0639\u064f\u0648\u0652\u0646\u064e","indoText":"Allah yang memulai penciptaan (makhluk), kemudian mengulanginya kembali; kemudian kepada-Nya kamu dikembalikan.","enText":"Allah begins creation; then He will repeat it; then to Him you will be returned.","readText":"all\u0101hu yabda`ul-khalqa \u1e61umma yu'\u012bduh\u1ee5 \u1e61umma ilaihi turja'\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030011.mp3","juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":12,"ayahText":"\u0648\u064e\u064a\u064e\u0648\u0652\u0645\u064e \u062a\u064e\u0642\u064f\u0648\u0652\u0645\u064f \u0627\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u064f \u064a\u064f\u0628\u0652\u0644\u0650\u0633\u064f \u0627\u0644\u0652\u0645\u064f\u062c\u0652\u0631\u0650\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"Dan pada hari (ketika) terjadi Kiamat, orang-orang yang berdosa (kaum musyrik) terdiam berputus asa.","enText":"And the Day the Hour appears the criminals will be in despair.","readText":"wa yauma taq\u1ee5mus-s\u0101'atu yublisul-mujrim\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030012.mp3","juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":13,"ayahText":"\u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u0651\u064e\u0647\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u06e4\u0649\u0655\u0650\u0647\u0650\u0645\u0652 \u0634\u064f\u0641\u064e\u0639\u0670\u06e4\u0624\u064f\u0627 \u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0628\u0650\u0634\u064f\u0631\u064e\u0643\u064e\u0627\u06e4\u0649\u0655\u0650\u0647\u0650\u0645\u0652 \u0643\u0670\u0641\u0650\u0631\u0650\u064a\u0652\u0646\u064e","indoText":"Dan tidak mungkin ada pemberi syafaat (pertolongan) bagi mereka dari berhala-berhala mereka, sedangkan mereka mengingkari berhala-berhala mereka itu.","enText":"And there will not be for them among their [alleged] partners any intercessors, and they will [then] be disbelievers in their partners.","readText":"wa lam yakul lahum min syurak\u0101`ihim syufa'\u0101`u wa k\u0101n\u1ee5 bisyurak\u0101`ihim k\u0101fir\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030013.mp3","juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":14,"ayahText":"\u0648\u064e\u064a\u064e\u0648\u0652\u0645\u064e \u062a\u064e\u0642\u064f\u0648\u0652\u0645\u064f \u0627\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u064f \u064a\u064e\u0648\u0652\u0645\u064e\u0649\u0655\u0650\u0630\u064d \u064a\u0651\u064e\u062a\u064e\u0641\u064e\u0631\u0651\u064e\u0642\u064f\u0648\u0652\u0646\u064e","indoText":"Dan pada hari (ketika) terjadi Kiamat, pada hari itu manusia terpecah-pecah (dalam kelompok).","enText":"And the Day the Hour appears - that Day they will become separated.","readText":"wa yauma taq\u1ee5mus-s\u0101'atu yauma`i\u017ciy yatafarraq\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030014.mp3","juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":15,"ayahText":"\u0641\u064e\u0627\u064e\u0645\u0651\u064e\u0627 \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0652\u0627 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627 \u0627\u0644\u0635\u0651\u0670\u0644\u0650\u062d\u0670\u062a\u0650 \u0641\u064e\u0647\u064f\u0645\u0652 \u0641\u0650\u064a\u0652 \u0631\u064e\u0648\u0652\u0636\u064e\u0629\u064d \u064a\u0651\u064f\u062d\u0652\u0628\u064e\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Maka adapun orang-orang yang beriman dan mengerjakan kebajikan, maka mereka di dalam taman (surga) bergembira.","enText":"And as for those who had believed and done righteous deeds, they will be in a garden [of Paradise], delighted.","readText":"fa ammalla\u017c\u012bna \u0101man\u1ee5 wa 'amilu\u1e63-\u1e63\u0101li\u1e25\u0101ti fa hum f\u012b rau\u1e0datiy yu\u1e25bar\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030015.mp3","juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":16,"ayahText":"\u0648\u064e\u0627\u064e\u0645\u0651\u064e\u0627 \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0652\u0627 \u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0652\u0627 \u0628\u0650\u0627\u0670\u064a\u0670\u062a\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u0650\u0642\u064e\u0627\u06e4\u0626\u0650 \u0627\u0644\u0652\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u0641\u064e\u0627\u064f\u0648\u0644\u0670\u06e4\u0649\u0655\u0650\u0643\u064e \u0641\u0650\u0649 \u0627\u0644\u0652\u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0645\u064f\u062d\u0652\u0636\u064e\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan adapun orang-orang yang kafir dan mendustakan ayat-ayat Kami serta (mendustakan) pertemuan hari akhirat, maka mereka tetap berada di dalam azab (neraka).","enText":"But as for those who disbelieved and denied Our verses and the meeting of the Hereafter, those will be brought into the punishment [to remain].","readText":"wa ammalla\u017c\u012bna kafar\u1ee5 wa ka\u017c\u017cab\u1ee5 bi`\u0101y\u0101tin\u0101 wa liq\u0101`il-\u0101khirati fa ul\u0101`ika fil-'a\u017c\u0101bi mu\u1e25\u1e0dar\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030016.mp3","juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":17,"ayahText":"\u0641\u064e\u0633\u064f\u0628\u0652\u062d\u0670\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u062d\u0650\u064a\u0652\u0646\u064e \u062a\u064f\u0645\u0652\u0633\u064f\u0648\u0652\u0646\u064e \u0648\u064e\u062d\u0650\u064a\u0652\u0646\u064e \u062a\u064f\u0635\u0652\u0628\u0650\u062d\u064f\u0648\u0652\u0646\u064e","indoText":"Maka bertasbihlah kepada Allah pada petang hari dan pada pagi hari (waktu subuh),","enText":"So exalted is Allah when you reach the evening and when you reach the morning.","readText":"fa sub-\u1e25\u0101nall\u0101hi \u1e25\u012bna tums\u1ee5na wa \u1e25\u012bna tu\u1e63bi\u1e25\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030017.mp3","juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":18,"ayahText":"\u0648\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0641\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0639\u064e\u0634\u0650\u064a\u0651\u064b\u0627 \u0648\u0651\u064e\u062d\u0650\u064a\u0652\u0646\u064e \u062a\u064f\u0638\u0652\u0647\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"dan segala puji bagi-Nya baik di langit, di bumi, pada malam hari dan pada waktu zuhur (tengah hari).","enText":"And to Him is [due all] praise throughout the heavens and the earth. And [exalted is He] at night and when you are at noon.","readText":"wa lahul-\u1e25amdu fis-sam\u0101w\u0101ti wal-ar\u1e0di wa 'asyiyyaw wa \u1e25\u012bna tu\u1e93-hir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030018.mp3","juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":19,"ayahText":"\u064a\u064f\u062e\u0652\u0631\u0650\u062c\u064f \u0627\u0644\u0652\u062d\u064e\u064a\u0651\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0645\u064e\u064a\u0651\u0650\u062a\u0650 \u0648\u064e\u064a\u064f\u062e\u0652\u0631\u0650\u062c\u064f \u0627\u0644\u0652\u0645\u064e\u064a\u0651\u0650\u062a\u064e \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u062d\u064e\u064a\u0651\u0650 \u0648\u064e\u064a\u064f\u062d\u0652\u064a\u0650 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0628\u064e\u0639\u0652\u062f\u064e \u0645\u064e\u0648\u0652\u062a\u0650\u0647\u064e\u0627 \u06d7\u0648\u064e\u0643\u064e\u0630\u0670\u0644\u0650\u0643\u064e \u062a\u064f\u062e\u0652\u0631\u064e\u062c\u064f\u0648\u0652\u0646\u064e","indoText":"Dia mengeluarkan yang hidup dari yang mati dan mengeluarkan yang mati dari yang hidup dan menghidupkan bumi setelah mati (kering). Dan seperti itulah kamu akan dikeluarkan (dari kubur).","enText":"He brings the living out of the dead and brings the dead out of the living and brings to life the earth after its lifelessness. And thus will you be brought out.","readText":"yukhrijul-\u1e25ayya minal-mayyiti wa yukhrijul-mayyita minal-\u1e25ayyi wa yu\u1e25yil-ar\u1e0da ba'da mautih\u0101, wa ka\u017c\u0101lika tukhraj\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030019.mp3","juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"verseId":20,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656\u0653 \u0627\u064e\u0646\u0652 \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u062a\u064f\u0631\u064e\u0627\u0628\u064d \u062b\u064f\u0645\u0651\u064e \u0627\u0650\u0630\u064e\u0627\u0653 \u0627\u064e\u0646\u0652\u062a\u064f\u0645\u0652 \u0628\u064e\u0634\u064e\u0631\u064c \u062a\u064e\u0646\u0652\u062a\u064e\u0634\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan kamu dari tanah, kemudian tiba-tiba kamu (menjadi) manusia yang berkembang biak.","enText":"And of His signs is that He created you from dust; then, suddenly you were human beings dispersing [throughout the earth].","readText":"wa min \u0101y\u0101tih\u012b an khalaqakum min tur\u0101bin \u1e61umma i\u017c\u0101 antum basyarun tantasyir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030020.mp3","juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":21,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656\u0653 \u0627\u064e\u0646\u0652 \u062e\u064e\u0644\u064e\u0642\u064e \u0644\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u0652 \u0627\u064e\u0632\u0652\u0648\u064e\u0627\u062c\u064b\u0627 \u0644\u0650\u0651\u062a\u064e\u0633\u0652\u0643\u064f\u0646\u064f\u0648\u0652\u0653\u0627 \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u064e\u0627 \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0628\u064e\u064a\u0652\u0646\u064e\u0643\u064f\u0645\u0652 \u0645\u0651\u064e\u0648\u064e\u062f\u0651\u064e\u0629\u064b \u0648\u0651\u064e\u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064b \u06d7\u0627\u0650\u0646\u0651\u064e \u0641\u0650\u064a\u0652 \u0630\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0627\u0670\u064a\u0670\u062a\u064d \u0644\u0650\u0651\u0642\u064e\u0648\u0652\u0645\u064d \u064a\u0651\u064e\u062a\u064e\u0641\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang berpikir.","enText":"And of His signs is that He created for you from yourselves mates that you may find tranquillity in them; and He placed between you affection and mercy. Indeed in that are signs for a people who give thought.","readText":"wa min \u0101y\u0101tih\u012b an khalaqa lakum min anfusikum azw\u0101jal litaskun\u016b ilaih\u0101 wa ja'ala bainakum mawaddataw wa ra\u1e25mah, inna f\u012b \u017c\u0101lika la`\u0101y\u0101til liqaumiy yatafakkar\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030021.mp3","juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":22,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656 \u062e\u064e\u0644\u0652\u0642\u064f \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0627\u062e\u0652\u062a\u0650\u0644\u064e\u0627\u0641\u064f \u0627\u064e\u0644\u0652\u0633\u0650\u0646\u064e\u062a\u0650\u0643\u064f\u0645\u0652 \u0648\u064e\u0627\u064e\u0644\u0652\u0648\u064e\u0627\u0646\u0650\u0643\u064f\u0645\u0652\u06d7 \u0627\u0650\u0646\u0651\u064e \u0641\u0650\u064a\u0652 \u0630\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0627\u0670\u064a\u0670\u062a\u064d \u0644\u0650\u0651\u0644\u0652\u0639\u0670\u0644\u0650\u0645\u0650\u064a\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya ialah penciptaan langit dan bumi, perbedaan bahasamu dan warna kulitmu. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda bagi orang-orang yang mengetahui.","enText":"And of His signs is the creation of the heavens and the earth and the diversity of your languages and your colors. Indeed in that are signs for those of knowledge.","readText":"wa min \u0101y\u0101tih\u012b khalqus-sam\u0101w\u0101ti wal-ar\u1e0di wakhtil\u0101fu alsinatikum wa alw\u0101nikum, inna f\u012b \u017c\u0101lika la`\u0101y\u0101til lil-'\u0101lim\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030022.mp3","juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":23,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656 \u0645\u064e\u0646\u064e\u0627\u0645\u064f\u0643\u064f\u0645\u0652 \u0628\u0650\u0627\u0644\u0651\u064e\u064a\u0652\u0644\u0650 \u0648\u064e\u0627\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u0650 \u0648\u064e\u0627\u0628\u0652\u062a\u0650\u063a\u064e\u0627\u06e4\u0624\u064f\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0641\u064e\u0636\u0652\u0644\u0650\u0647\u0656\u06d7 \u0627\u0650\u0646\u0651\u064e \u0641\u0650\u064a\u0652 \u0630\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0627\u0670\u064a\u0670\u062a\u064d \u0644\u0650\u0651\u0642\u064e\u0648\u0652\u0645\u064d \u064a\u0651\u064e\u0633\u0652\u0645\u064e\u0639\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya ialah tidurmu pada waktu malam dan siang hari dan usahamu mencari sebagian dari karunia-Nya. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda bagi kaum yang mendengarkan.","enText":"And of His signs is your sleep by night and day and your seeking of His bounty. Indeed in that are signs for a people who listen.","readText":"wa min \u0101y\u0101tih\u012b man\u0101mukum bil-laili wan-nah\u0101ri wabtig\u0101`ukum min fa\u1e0dlih, inna f\u012b \u017c\u0101lika la`\u0101y\u0101til liqaumiy yasma'\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030023.mp3","juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":24,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656 \u064a\u064f\u0631\u0650\u064a\u0652\u0643\u064f\u0645\u064f \u0627\u0644\u0652\u0628\u064e\u0631\u0652\u0642\u064e \u062e\u064e\u0648\u0652\u0641\u064b\u0627 \u0648\u0651\u064e\u0637\u064e\u0645\u064e\u0639\u064b\u0627 \u0648\u0651\u064e\u064a\u064f\u0646\u064e\u0632\u0651\u0650\u0644\u064f \u0645\u0650\u0646\u064e \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u06e4\u0621\u0650 \u0645\u064e\u0627\u06e4\u0621\u064b \u0641\u064e\u064a\u064f\u062d\u0652\u064a\u0656 \u0628\u0650\u0647\u0650 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0628\u064e\u0639\u0652\u062f\u064e \u0645\u064e\u0648\u0652\u062a\u0650\u0647\u064e\u0627\u06d7 \u0627\u0650\u0646\u0651\u064e \u0641\u0650\u064a\u0652 \u0630\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0627\u0670\u064a\u0670\u062a\u064d \u0644\u0650\u0651\u0642\u064e\u0648\u0652\u0645\u064d \u064a\u0651\u064e\u0639\u0652\u0642\u0650\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya, Dia memperlihatkan kilat kepadamu untuk (menimbulkan) ketakutan dan harapan, dan Dia menurunkan air (hujan) dari langit, lalu dengan air itu dihidupkannya bumi setelah mati (kering). Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda bagi kaum yang mengerti.","enText":"And of His signs is [that] He shows you the lightning [causing] fear and aspiration, and He sends down rain from the sky by which He brings to life the earth after its lifelessness. Indeed in that are signs for a people who use reason.","readText":"wa min \u0101y\u0101tih\u012b yur\u012bkumul-barqa khaufaw wa \u1e6dama'aw wa yunazzilu minas-sam\u0101`i m\u0101`an fa yu\u1e25y\u012b bihil-ar\u1e0da ba'da mautih\u0101, inna f\u012b \u017c\u0101lika la`\u0101y\u0101til liqaumiy ya'qil\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030024.mp3","juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":25,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656\u0653 \u0627\u064e\u0646\u0652 \u062a\u064e\u0642\u064f\u0648\u0652\u0645\u064e \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u06e4\u0621\u064f \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064f \u0628\u0650\u0627\u064e\u0645\u0652\u0631\u0650\u0647\u0656\u06d7 \u062b\u064f\u0645\u0651\u064e \u0627\u0650\u0630\u064e\u0627 \u062f\u064e\u0639\u064e\u0627\u0643\u064f\u0645\u0652 \u062f\u064e\u0639\u0652\u0648\u064e\u0629\u064b\u06d6 \u0645\u0650\u0651\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0627\u0650\u0630\u064e\u0627\u0653 \u0627\u064e\u0646\u0652\u062a\u064f\u0645\u0652 \u062a\u064e\u062e\u0652\u0631\u064f\u062c\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya ialah berdirinya langit dan bumi dengan kehendak-Nya. Kemudian apabila Dia memanggil kamu sekali panggil dari bumi, seketika itu kamu keluar (dari kubur).","enText":"And of His signs is that the heaven and earth remain by His command. Then when He calls you with a [single] call from the earth, immediately you will come forth.","readText":"wa min \u0101y\u0101tih\u012b an taq\u1ee5mas-sam\u0101`u wal-ar\u1e0du bi`amrih, \u1e61umma i\u017c\u0101 da'\u0101kum da'watam minal-ar\u1e0di i\u017c\u0101 antum takhruj\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030025.mp3","juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":26,"ayahText":"\u0648\u064e\u0644\u064e\u0647\u0657 \u0645\u064e\u0646\u0652 \u0641\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650\u06d7 \u0643\u064f\u0644\u0651\u064c \u0644\u0651\u064e\u0647\u0657 \u0642\u064e\u0627\u0646\u0650\u062a\u064f\u0648\u0652\u0646\u064e","indoText":"Dan milik-Nya apa yang di langit dan di bumi. Semuanya hanya kepada-Nya tunduk.","enText":"And to Him belongs whoever is in the heavens and earth. All are to Him devoutly obedient.","readText":"wa lah\u1ee5 man fis-sam\u0101w\u0101ti wal-ar\u1e0d, kullul lah\u1ee5 q\u0101nit\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030026.mp3","juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":27,"ayahText":"\u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u064a\u064e\u0628\u0652\u062f\u064e\u0624\u064f\u0627 \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u064e \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0639\u0650\u064a\u0652\u062f\u064f\u0647\u0657 \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u064e\u0647\u0652\u0648\u064e\u0646\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u06d7 \u0648\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0645\u064e\u062b\u064e\u0644\u064f \u0627\u0644\u0652\u0627\u064e\u0639\u0652\u0644\u0670\u0649 \u0641\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0652\u0632\u064f \u0627\u0644\u0652\u062d\u064e\u0643\u0650\u064a\u0652\u0645\u064f","indoText":"Dan Dialah yang memulai penciptaan, kemudian mengulanginya kembali, dan itu lebih mudah bagi-Nya. Dia memiliki sifat yang Mahatinggi di langit dan di bumi. Dan Dialah Yang Mahaperkasa, Mahabijaksana.","enText":"And it is He who begins creation; then He repeats it, and that is [even] easier for Him. To Him belongs the highest attribute in the heavens and earth. And He is the Exalted in Might, the Wise.","readText":"wa huwalla\u017c\u012b yabda`ul-khalqa \u1e61umma yu'\u012bduh\u1ee5 wa huwa ahwanu 'ala\u012bh, wa lahul-ma\u1e61alul-a'l\u0101 fis-sam\u0101w\u0101ti wal-ar\u1e0d, wa huwal-'az\u012bzul-\u1e25ak\u012bm","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030027.mp3","juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"verseId":28,"ayahText":"\u0636\u064e\u0631\u064e\u0628\u064e \u0644\u064e\u0643\u064f\u0645\u0652 \u0645\u0651\u064e\u062b\u064e\u0644\u064b\u0627 \u0645\u0651\u0650\u0646\u0652 \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u0650\u0643\u064f\u0645\u0652\u06d7 \u0647\u064e\u0644\u0652 \u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0645\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0643\u064e\u062a\u0652 \u0627\u064e\u064a\u0652\u0645\u064e\u0627\u0646\u064f\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u06e4\u0621\u064e \u0641\u0650\u064a\u0652 \u0645\u064e\u0627 \u0631\u064e\u0632\u064e\u0642\u0652\u0646\u0670\u0643\u064f\u0645\u0652 \u0641\u064e\u0627\u064e\u0646\u0652\u062a\u064f\u0645\u0652 \u0641\u0650\u064a\u0652\u0647\u0650 \u0633\u064e\u0648\u064e\u0627\u06e4\u0621\u064c \u062a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0652\u0646\u064e\u0647\u064f\u0645\u0652 \u0643\u064e\u062e\u0650\u064a\u0652\u0641\u064e\u062a\u0650\u0643\u064f\u0645\u0652 \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u0652\u06d7 \u0643\u064e\u0630\u0670\u0644\u0650\u0643\u064e \u0646\u064f\u0641\u064e\u0635\u0651\u0650\u0644\u064f \u0627\u0644\u0652\u0627\u0670\u064a\u0670\u062a\u0650 \u0644\u0650\u0642\u064e\u0648\u0652\u0645\u064d \u064a\u0651\u064e\u0639\u0652\u0642\u0650\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dia membuat perumpamaan bagimu dari dirimu sendiri. Apakah (kamu rela jika) ada di antara hamba sahaya yang kamu miliki, menjadi sekutu bagimu dalam (memiliki) rezeki yang telah Kami berikan kepadamu, sehingga kamu menjadi setara dengan mereka dalam hal ini, lalu kamu takut kepada mereka sebagaimana kamu takut kepada sesamamu. Demikianlah Kami jelaskan ayat-ayat itu bagi kaum yang mengerti.","enText":"He presents to you an example from yourselves. Do you have among those whom your right hands possess any partners in what We have provided for you so that you are equal therein [and] would fear them as your fear of one another [within a partnership]? Thus do We detail the verses for a people who use reason.","readText":"\u1e0daraba lakum ma\u1e61alam min anfusikum, hal lakum mimm\u0101 malakat aim\u0101nukum min syurak\u0101`a f\u012b m\u0101 razaqn\u0101kum fa antum f\u012bhi saw\u0101`un takh\u0101f\u1ee5nahum kakh\u012bfatikum anfusakum, ka\u017c\u0101lika nufa\u1e63\u1e63ilul-\u0101y\u0101ti liqaumiy ya'qil\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030028.mp3","juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"verseId":29,"ayahText":"\u0628\u064e\u0644\u0650 \u0627\u062a\u0651\u064e\u0628\u064e\u0639\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0638\u064e\u0644\u064e\u0645\u064f\u0648\u0652\u0653\u0627 \u0627\u064e\u0647\u0652\u0648\u064e\u0627\u06e4\u0621\u064e\u0647\u064f\u0645\u0652 \u0628\u0650\u063a\u064e\u064a\u0652\u0631\u0650 \u0639\u0650\u0644\u0652\u0645\u064d\u06d7 \u0641\u064e\u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u0647\u0652\u062f\u0650\u064a\u0652 \u0645\u064e\u0646\u0652 \u0627\u064e\u0636\u064e\u0644\u0651\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u06d7\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0646\u0651\u0670\u0635\u0650\u0631\u0650\u064a\u0652\u0646\u064e","indoText":"Tetapi orang-orang yang zalim, mengikuti keinginannya tanpa ilmu pengetahuan; maka siapakah yang dapat memberi petunjuk kepada orang yang telah disesatkan Allah. Dan tidak ada seorang penolong pun bagi mereka.","enText":"But those who wrong follow their [own] desires without knowledge. Then who can guide one whom Allah has sent astray? And for them there are no helpers.","readText":"balittaba'alla\u017c\u012bna \u1e93alam\u016b ahw\u0101`ahum bigairi 'ilm, fa may yahd\u012b man a\u1e0dallall\u0101h, wa m\u0101 lahum min n\u0101\u1e63ir\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030029.mp3","juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"verseId":30,"ayahText":"\u0641\u064e\u0627\u064e\u0642\u0650\u0645\u0652 \u0648\u064e\u062c\u0652\u0647\u064e\u0643\u064e \u0644\u0650\u0644\u062f\u0651\u0650\u064a\u0652\u0646\u0650 \u062d\u064e\u0646\u0650\u064a\u0652\u0641\u064b\u0627\u06d7 \u0641\u0650\u0637\u0652\u0631\u064e\u062a\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0651\u064e\u062a\u0650\u064a\u0652 \u0641\u064e\u0637\u064e\u0631\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u064e\u0627\u06d7 \u0644\u064e\u0627 \u062a\u064e\u0628\u0652\u062f\u0650\u064a\u0652\u0644\u064e \u0644\u0650\u062e\u064e\u0644\u0652\u0642\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u06d7\u0630\u0670\u0644\u0650\u0643\u064e \u0627\u0644\u062f\u0651\u0650\u064a\u0652\u0646\u064f \u0627\u0644\u0652\u0642\u064e\u064a\u0651\u0650\u0645\u064f\u06d9 \u0648\u064e\u0644\u0670\u0643\u0650\u0646\u0651\u064e \u0627\u064e\u0643\u0652\u062b\u064e\u0631\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0652\u0646\u064e\u06d9","indoText":"Maka hadapkanlah wajahmu dengan lurus kepada agama (Islam); (sesuai) fitrah Allah disebabkan Dia telah menciptakan manusia menurut (fitrah) itu. Tidak ada perubahan pada ciptaan Allah. (Itulah) agama yang lurus, tetapi kebanyakan manusia tidak mengetahui,","enText":"So direct your face toward the religion, inclining to truth. [Adhere to] the fitrah of Allah upon which He has created [all] people. No change should there be in the creation of Allah. That is the correct religion, but most of the people do not know.","readText":"fa aqim waj-haka lid-d\u012bni \u1e25an\u012bf\u0101, fi\u1e6dratall\u0101hillat\u012b fa\u1e6daran-n\u0101sa 'alaih\u0101, l\u0101 tabd\u012bla likhalqill\u0101h, \u017c\u0101likad-d\u012bnul qayyimu wa l\u0101kinna ak\u1e61aran-n\u0101si l\u0101 ya'lam\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030030.mp3","juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"verseId":31,"ayahText":"\u06de \u0645\u064f\u0646\u0650\u064a\u0652\u0628\u0650\u064a\u0652\u0646\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0627\u062a\u0651\u064e\u0642\u064f\u0648\u0652\u0647\u064f \u0648\u064e\u0627\u064e\u0642\u0650\u064a\u0652\u0645\u064f\u0648\u0627 \u0627\u0644\u0635\u0651\u064e\u0644\u0670\u0648\u0629\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0643\u064f\u0648\u0652\u0646\u064f\u0648\u0652\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u0645\u064f\u0634\u0652\u0631\u0650\u0643\u0650\u064a\u0652\u0646\u064e\u06d9","indoText":"dengan kembali bertobat kepada-Nya dan bertakwalah kepada-Nya serta laksanakanlah salat dan janganlah kamu termasuk orang-orang yang mempersekutukan Allah,","enText":"[Adhere to it], turning in repentance to Him, and fear Him and establish prayer and do not be of those who associate others with Allah","readText":"mun\u012bb\u012bna ilaihi wattaq\u1ee5hu wa aq\u012bmu\u1e63-\u1e63al\u0101ta wa l\u0101 tak\u1ee5n\u1ee5 minal-musyrik\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030031.mp3","juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":32,"ayahText":"\u0645\u0650\u0646\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0641\u064e\u0631\u0651\u064e\u0642\u064f\u0648\u0652\u0627 \u062f\u0650\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u0652 \u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0634\u0650\u064a\u064e\u0639\u064b\u0627 \u06d7 \u0643\u064f\u0644\u0651\u064f \u062d\u0650\u0632\u0652\u0628\u064d\u06e2 \u0628\u0650\u0645\u064e\u0627 \u0644\u064e\u062f\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0641\u064e\u0631\u0650\u062d\u064f\u0648\u0652\u0646\u064e","indoText":"yaitu orang-orang yang memecah belah agama mereka dan mereka menjadi beberapa golongan. Setiap golongan merasa bangga dengan apa yang ada pada golongan mereka.","enText":"[Or] of those who have divided their religion and become sects, every faction rejoicing in what it has.","readText":"minalla\u017c\u012bna farraq\u1ee5 d\u012bnahum wa k\u0101n\u1ee5 syiya'\u0101, kullu \u1e25izbim bim\u0101 ladaihim fari\u1e25\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030032.mp3","juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":33,"ayahText":"\u0648\u064e\u0627\u0650\u0630\u064e\u0627 \u0645\u064e\u0633\u0651\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u0636\u064f\u0631\u0651\u064c \u062f\u064e\u0639\u064e\u0648\u0652\u0627 \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u0645\u0652 \u0645\u0651\u064f\u0646\u0650\u064a\u0652\u0628\u0650\u064a\u0652\u0646\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u062b\u064f\u0645\u0651\u064e \u0627\u0650\u0630\u064e\u0627\u0653 \u0627\u064e\u0630\u064e\u0627\u0642\u064e\u0647\u064f\u0645\u0652 \u0645\u0651\u0650\u0646\u0652\u0647\u064f \u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064b \u0627\u0650\u0630\u064e\u0627 \u0641\u064e\u0631\u0650\u064a\u0652\u0642\u064c \u0645\u0651\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u0652 \u064a\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0652\u0646\u064e\u06d9","indoText":"Dan apabila manusia ditimpa oleh suatu bahaya, mereka menyeru Tuhannya dengan kembali (bertobat) kepada-Nya, kemudian apabila Dia memberikan sedikit rahmat-Nya kepada mereka, tiba-tiba sebagian mereka mempersekutukan Allah.","enText":"And when adversity touches the people, they call upon their Lord, turning in repentance to Him. Then when He lets them taste mercy from Him, at once a party of them associate others with their Lord,","readText":"wa i\u017c\u0101 massan-n\u0101sa \u1e0durrun da'au rabbahum mun\u012bb\u012bna ilaihi \u1e61umma i\u017c\u0101 a\u017c\u0101qahum min-hu ra\u1e25matan i\u017c\u0101 far\u012bqum min-hum birabbihim yusyrik\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030033.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":34,"ayahText":"\u0644\u0650\u064a\u064e\u0643\u0652\u0641\u064f\u0631\u064f\u0648\u0652\u0627 \u0628\u0650\u0645\u064e\u0627\u0653 \u0627\u0670\u062a\u064e\u064a\u0652\u0646\u0670\u0647\u064f\u0645\u0652\u06d7 \u0641\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0652\u0627\u06d7 \u0641\u064e\u0633\u064e\u0648\u0652\u0641\u064e \u062a\u064e\u0639\u0652\u0644\u064e\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"Biarkan mereka mengingkari rahmat yang telah Kami berikan. Dan bersenang-senanglah kamu, maka kelak kamu akan mengetahui (akibat perbuatanmu).","enText":"So that they will deny what We have granted them. Then enjoy yourselves, for you are going to know.","readText":"liyakfur\u1ee5 bim\u0101 \u0101tain\u0101hum, fa tamatta'\u1ee5, fa saufa ta'lam\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030034.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":35,"ayahText":"\u0627\u064e\u0645\u0652 \u0627\u064e\u0646\u0652\u0632\u064e\u0644\u0652\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0633\u064f\u0644\u0652\u0637\u0670\u0646\u064b\u0627 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0628\u0650\u0647\u0656 \u064a\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0652\u0646\u064e","indoText":"Atau pernahkah Kami menurunkan kepada mereka keterangan, yang menjelaskan (membenarkan) apa yang (selalu) mereka persekutukan dengan Tuhan?","enText":"Or have We sent down to them an authority, and it speaks of what they were associating with Him?","readText":"am anzaln\u0101 'alaihim sul\u1e6d\u0101nan fa huwa yatakallamu bim\u0101 k\u0101n\u1ee5 bih\u012b yusyrik\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030035.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":36,"ayahText":"\u0648\u064e\u0627\u0650\u0630\u064e\u0627\u0653 \u0627\u064e\u0630\u064e\u0642\u0652\u0646\u064e\u0627 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u0631\u064e\u062d\u0652\u0645\u064e\u0629\u064b \u0641\u064e\u0631\u0650\u062d\u064f\u0648\u0652\u0627 \u0628\u0650\u0647\u064e\u0627\u06d7 \u0648\u064e\u0627\u0650\u0646\u0652 \u062a\u064f\u0635\u0650\u0628\u0652\u0647\u064f\u0645\u0652 \u0633\u064e\u064a\u0651\u0650\u0626\u064e\u0629\u064c \u06e2\u0628\u0650\u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u0652 \u0627\u064e\u064a\u0652\u062f\u0650\u064a\u0652\u0647\u0650\u0645\u0652 \u0627\u0650\u0630\u064e\u0627 \u0647\u064f\u0645\u0652 \u064a\u064e\u0642\u0652\u0646\u064e\u0637\u064f\u0648\u0652\u0646\u064e","indoText":"Dan apabila Kami berikan sesuatu rahmat kepada manusia, niscaya mereka gembira dengan (rahmat) itu. Tetapi apabila mereka ditimpa sesuatu musibah (bahaya) karena kesalahan mereka sendiri, seketika itu mereka berputus asa.","enText":"And when We let the people taste mercy, they rejoice therein, but if evil afflicts them for what their hands have put forth, immediately they despair.","readText":"wa i\u017c\u0101 a\u017caqnan-n\u0101sa ra\u1e25matan fari\u1e25\u1ee5 bih\u0101, wa in tu\u1e63ib-hum sayyi`atum bim\u0101 qaddamat aid\u012bhim i\u017c\u0101 hum yaqna\u1e6d\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030036.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":37,"ayahText":"\u0627\u064e\u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0631\u064e\u0648\u0652\u0627 \u0627\u064e\u0646\u0651\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u064a\u064e\u0628\u0652\u0633\u064f\u0637\u064f \u0627\u0644\u0631\u0651\u0650\u0632\u0652\u0642\u064e \u0644\u0650\u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u0634\u064e\u0627\u06e4\u0621\u064f \u0648\u064e\u064a\u064e\u0642\u0652\u062f\u0650\u0631\u064f\u06d7 \u0627\u0650\u0646\u0651\u064e \u0641\u0650\u064a\u0652 \u0630\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0627\u0670\u064a\u0670\u062a\u064d \u0644\u0650\u0651\u0642\u064e\u0648\u0652\u0645\u064d \u064a\u0651\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0652\u0646\u064e","indoText":"Dan tidakkah mereka memperhatikan bahwa Allah yang melapangkan rezeki bagi siapa yang Dia kehendaki dan Dia (pula) yang membatasi (bagi siapa yang Dia kehendaki). Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang beriman.","enText":"Do they not see that Allah extends provision for whom He wills and restricts [it]? Indeed, in that are signs for a people who believe.","readText":"a wa lam yarau annall\u0101ha yabsu\u1e6dur-rizqa limay yasy\u0101`u wa yaqdir, inna f\u012b \u017c\u0101lika la`\u0101y\u0101til liqaumiy yu`min\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030037.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":38,"ayahText":"\u0641\u064e\u0627\u0670\u062a\u0650 \u0630\u064e\u0627 \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0628\u0670\u0649 \u062d\u064e\u0642\u0651\u064e\u0647\u0657 \u0648\u064e\u0627\u0644\u0652\u0645\u0650\u0633\u0652\u0643\u0650\u064a\u0652\u0646\u064e \u0648\u064e\u0627\u0628\u0652\u0646\u064e \u0627\u0644\u0633\u0651\u064e\u0628\u0650\u064a\u0652\u0644\u0650\u06d7 \u0630\u0670\u0644\u0650\u0643\u064e \u062e\u064e\u064a\u0652\u0631\u064c \u0644\u0650\u0651\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u064a\u064f\u0631\u0650\u064a\u0652\u062f\u064f\u0648\u0652\u0646\u064e \u0648\u064e\u062c\u0652\u0647\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u06d6\u0648\u064e\u0627\u064f\u0648\u0644\u0670\u06e4\u0649\u0655\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0627\u0644\u0652\u0645\u064f\u0641\u0652\u0644\u0650\u062d\u064f\u0648\u0652\u0646\u064e","indoText":"Maka berikanlah haknya kepada kerabat dekat, juga kepada orang miskin dan orang-orang yang dalam perjalanan. Itulah yang lebih baik bagi orang-orang yang mencari keridaan Allah. Dan mereka itulah orang-orang yang beruntung.","enText":"So give the relative his right, as well as the needy and the traveler. That is best for those who desire the countenance of Allah, and it is they who will be the successful.","readText":"fa \u0101ti \u017cal-qurb\u0101 \u1e25aqqah\u1ee5 wal-misk\u012bna wabnas-sab\u012bl, \u017c\u0101lika khairul lilla\u017c\u012bna yur\u012bd\u1ee5na waj-hall\u0101hi wa ul\u0101`ika humul-mufli\u1e25\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030038.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":39,"ayahText":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0627\u0670\u062a\u064e\u064a\u0652\u062a\u064f\u0645\u0652 \u0645\u0651\u0650\u0646\u0652 \u0631\u0650\u0651\u0628\u064b\u0627 \u0644\u0650\u0651\u064a\u064e\u0631\u0652\u0628\u064f\u0648\u064e\u0627\u06e0 \u0641\u0650\u064a\u0652\u0653 \u0627\u064e\u0645\u0652\u0648\u064e\u0627\u0644\u0650 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u0641\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u0652\u0628\u064f\u0648\u0652\u0627 \u0639\u0650\u0646\u0652\u062f\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u06da\u0648\u064e\u0645\u064e\u0627\u0653 \u0627\u0670\u062a\u064e\u064a\u0652\u062a\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0632\u064e\u0643\u0670\u0648\u0629\u064d \u062a\u064f\u0631\u0650\u064a\u0652\u062f\u064f\u0648\u0652\u0646\u064e \u0648\u064e\u062c\u0652\u0647\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0641\u064e\u0627\u064f\u0648\u0644\u0670\u06e4\u0649\u0655\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0627\u0644\u0652\u0645\u064f\u0636\u0652\u0639\u0650\u0641\u064f\u0648\u0652\u0646\u064e","indoText":"Dan sesuatu riba (tambahan) yang kamu berikan agar harta manusia bertambah, maka tidak bertambah dalam pandangan Allah. Dan apa yang kamu berikan berupa zakat yang kamu maksudkan untuk memperoleh keridaan Allah, maka itulah orang-orang yang melipatgandakan (pahalanya).","enText":"And whatever you give for interest to increase within the wealth of people will not increase with Allah. But what you give in zakah, desiring the countenance of Allah - those are the multipliers.","readText":"wa m\u0101 \u0101taitum mir ribal liyarbuwa f\u012b amw\u0101lin-n\u0101si fa l\u0101 yarb\u1ee5 'indall\u0101h, wa m\u0101 \u0101taitum min zak\u0101tin tur\u012bd\u1ee5na waj-hall\u0101hi fa ul\u0101`ika humul-mu\u1e0d'if\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030039.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":40,"ayahText":"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064f\u0645\u0652 \u062b\u064f\u0645\u0651\u064e \u0631\u064e\u0632\u064e\u0642\u064e\u0643\u064f\u0645\u0652 \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0645\u0650\u064a\u0652\u062a\u064f\u0643\u064f\u0645\u0652 \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u062d\u0652\u064a\u0650\u064a\u0652\u0643\u064f\u0645\u0652\u06d7 \u0647\u064e\u0644\u0652 \u0645\u0650\u0646\u0652 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u06e4\u0649\u0655\u0650\u0643\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u064a\u0651\u064e\u0641\u0652\u0639\u064e\u0644\u064f \u0645\u0650\u0646\u0652 \u0630\u0670\u0644\u0650\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0634\u064e\u064a\u0652\u0621\u064d\u06d7 \u0633\u064f\u0628\u0652\u062d\u0670\u0646\u064e\u0647\u0657 \u0648\u064e\u062a\u064e\u0639\u0670\u0644\u0670\u0649 \u0639\u064e\u0645\u0651\u064e\u0627 \u064a\u064f\u0634\u0652\u0631\u0650\u0643\u064f\u0648\u0652\u0646\u064e","indoText":"Allah yang menciptakan kamu, kemudian memberimu rezeki, lalu mematikanmu, kemudian menghidupkanmu (kembali). Adakah di antara mereka yang kamu sekutukan dengan Allah itu yang dapat berbuat sesuatu yang demikian itu? Mahasuci Dia dan Mahatinggi dari apa yang mereka persekutukan.","enText":"Allah is the one who created you, then provided for you, then will cause you to die, and then will give you life. Are there any of your \"partners\" who does anything of that? Exalted is He and high above what they associate with Him.","readText":"all\u0101hulla\u017c\u012b khalaqakum \u1e61umma razaqakum \u1e61umma yum\u012btukum \u1e61umma yu\u1e25y\u012bkum, hal min syurak\u0101`ikum may yaf'alu min \u017c\u0101likum min sya\u012b`, sub-\u1e25\u0101nah\u1ee5 wa ta'\u0101l\u0101 'amm\u0101 yusyrik\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030040.mp3","juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"verseId":41,"ayahText":"\u0638\u064e\u0647\u064e\u0631\u064e \u0627\u0644\u0652\u0641\u064e\u0633\u064e\u0627\u062f\u064f \u0641\u0650\u0649 \u0627\u0644\u0652\u0628\u064e\u0631\u0651\u0650 \u0648\u064e\u0627\u0644\u0652\u0628\u064e\u062d\u0652\u0631\u0650 \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u0652 \u0627\u064e\u064a\u0652\u062f\u0650\u0649 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u0644\u0650\u064a\u064f\u0630\u0650\u064a\u0652\u0642\u064e\u0647\u064f\u0645\u0652 \u0628\u064e\u0639\u0652\u0636\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0652\u0627 \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0631\u0652\u062c\u0650\u0639\u064f\u0648\u0652\u0646\u064e","indoText":"Telah tampak kerusakan di darat dan di laut disebabkan karena perbuatan tangan manusia; Allah menghendaki agar mereka merasakan sebagian dari (akibat) perbuatan mereka, agar mereka kembali (ke jalan yang benar).","enText":"Corruption has appeared throughout the land and sea by [reason of] what the hands of people have earned so He may let them taste part of [the consequence of] what they have done that perhaps they will return [to righteousness].","readText":"\u1e93aharal-fas\u0101du fil-barri wal-ba\u1e25ri bim\u0101 kasabat aidin-n\u0101si liyu\u017c\u012bqahum ba'\u1e0dalla\u017c\u012b 'amil\u1ee5 la'allahum yarji'\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030041.mp3","juz":21,"manzil":5,"page":408,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":42,"ayahText":"\u0642\u064f\u0644\u0652 \u0633\u0650\u064a\u0652\u0631\u064f\u0648\u0652\u0627 \u0641\u0650\u0649 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0641\u064e\u0627\u0646\u0652\u0638\u064f\u0631\u064f\u0648\u0652\u0627 \u0643\u064e\u064a\u0652\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0627\u0642\u0650\u0628\u064e\u0629\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u064f\u06d7 \u0643\u064e\u0627\u0646\u064e \u0627\u064e\u0643\u0652\u062b\u064e\u0631\u064f\u0647\u064f\u0645\u0652 \u0645\u0651\u064f\u0634\u0652\u0631\u0650\u0643\u0650\u064a\u0652\u0646\u064e","indoText":"Katakanlah (Muhammad), \u201cBepergianlah di bumi lalu lihatlah bagaimana kesudahan orang-orang dahulu. Kebanyakan dari mereka adalah orang-orang yang mempersekutukan (Allah).\u201d","enText":"Say, [O Muhammad], \"Travel through the land and observe how was the end of those before. Most of them were associators [of others with Allah].","readText":"qul s\u012br\u1ee5 fil-ar\u1e0di fan\u1e93ur\u1ee5 kaifa k\u0101na '\u0101qibatulla\u017c\u012bna ming qabl, k\u0101na ak\u1e61aruhum musyrik\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030042.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":43,"ayahText":"\u0641\u064e\u0627\u064e\u0642\u0650\u0645\u0652 \u0648\u064e\u062c\u0652\u0647\u064e\u0643\u064e \u0644\u0650\u0644\u062f\u0651\u0650\u064a\u0652\u0646\u0650 \u0627\u0644\u0652\u0642\u064e\u064a\u0651\u0650\u0645\u0650 \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650 \u0627\u064e\u0646\u0652 \u064a\u0651\u064e\u0623\u0652\u062a\u0650\u064a\u064e \u064a\u064e\u0648\u0652\u0645\u064c \u0644\u0651\u064e\u0627 \u0645\u064e\u0631\u064e\u062f\u0651\u064e \u0644\u064e\u0647\u0657 \u0645\u0650\u0646\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u064a\u064e\u0648\u0652\u0645\u064e\u0649\u0655\u0650\u0630\u064d \u064a\u0651\u064e\u0635\u0651\u064e\u062f\u0651\u064e\u0639\u064f\u0648\u0652\u0646\u064e","indoText":"Oleh karena itu, hadapkanlah wajahmu kepada agama yang lurus (Islam) sebelum datang dari Allah suatu hari (Kiamat) yang tidak dapat ditolak, pada hari itu mereka terpisah-pisah.","enText":"So direct your face toward the correct religion before a Day comes from Allah of which there is no repelling. That Day, they will be divided.","readText":"fa aqim waj-haka lidd\u012bnil-qayyimi ming qabli ay ya`tiya yaumul l\u0101 maradda lah\u1ee5 minall\u0101hi yauma`i\u017ciy ya\u1e63\u1e63adda'\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030043.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":44,"ayahText":"\u0645\u064e\u0646\u0652 \u0643\u064e\u0641\u064e\u0631\u064e \u0641\u064e\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0643\u064f\u0641\u0652\u0631\u064f\u0647\u0657\u06da \u0648\u064e\u0645\u064e\u0646\u0652 \u0639\u064e\u0645\u0650\u0644\u064e \u0635\u064e\u0627\u0644\u0650\u062d\u064b\u0627 \u0641\u064e\u0644\u0650\u0627\u064e\u0646\u0652\u0641\u064f\u0633\u0650\u0647\u0650\u0645\u0652 \u064a\u064e\u0645\u0652\u0647\u064e\u062f\u064f\u0648\u0652\u0646\u064e\u06d9","indoText":"Barangsiapa kafir maka dia sendirilah yang menanggung (akibat) kekafirannya itu; dan barangsiapa mengerjakan kebajikan maka mereka menyiapkan untuk diri mereka sendiri (tempat yang menyenangkan),","enText":"Whoever disbelieves - upon him is [the consequence of] his disbelief. And whoever does righteousness - they are for themselves preparing,","readText":"mang kafara fa 'alaihi kufruh, wa man 'amila \u1e63\u0101li\u1e25an fa li`anfusihim yam-had\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030044.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":45,"ayahText":"\u0644\u0650\u064a\u064e\u062c\u0652\u0632\u0650\u064a\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0652\u0627 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627 \u0627\u0644\u0635\u0651\u0670\u0644\u0650\u062d\u0670\u062a\u0650 \u0645\u0650\u0646\u0652 \u0641\u064e\u0636\u0652\u0644\u0650\u0647\u0656\u06d7 \u0627\u0650\u0646\u0651\u064e\u0647\u0657 \u0644\u064e\u0627 \u064a\u064f\u062d\u0650\u0628\u0651\u064f \u0627\u0644\u0652\u0643\u0670\u0641\u0650\u0631\u0650\u064a\u0652\u0646\u064e","indoText":"agar Allah memberi balasan (pahala) kepada orang-orang yang beriman dan mengerjakan kebajikan dari karunia-Nya. Sungguh, Dia tidak menyukai orang-orang yang ingkar (kafir).","enText":"That He may reward those who have believed and done righteous deeds out of His bounty. Indeed, He does not like the disbelievers.","readText":"liyajziyalla\u017c\u012bna \u0101man\u1ee5 wa 'amilu\u1e63-\u1e63\u0101li\u1e25\u0101ti min fa\u1e0dlih, innah\u1ee5 l\u0101 yu\u1e25ibbul-k\u0101fir\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030045.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":46,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652 \u0627\u0670\u064a\u0670\u062a\u0650\u0647\u0656\u0653 \u0627\u064e\u0646\u0652 \u064a\u0651\u064f\u0631\u0652\u0633\u0650\u0644\u064e \u0627\u0644\u0631\u0651\u0650\u064a\u0670\u062d\u064e \u0645\u064f\u0628\u064e\u0634\u0651\u0650\u0631\u0670\u062a\u064d \u0648\u0651\u064e\u0644\u0650\u064a\u064f\u0630\u0650\u064a\u0652\u0642\u064e\u0643\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0631\u0651\u064e\u062d\u0652\u0645\u064e\u062a\u0650\u0647\u0656 \u0648\u064e\u0644\u0650\u062a\u064e\u062c\u0652\u0631\u0650\u064a\u064e \u0627\u0644\u0652\u0641\u064f\u0644\u0652\u0643\u064f \u0628\u0650\u0627\u064e\u0645\u0652\u0631\u0650\u0647\u0656 \u0648\u064e\u0644\u0650\u062a\u064e\u0628\u0652\u062a\u064e\u063a\u064f\u0648\u0652\u0627 \u0645\u0650\u0646\u0652 \u0641\u064e\u0636\u0652\u0644\u0650\u0647\u0656 \u0648\u064e\u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u0652 \u062a\u064e\u0634\u0652\u0643\u064f\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara tanda-tanda (kebesaran)-Nya adalah bahwa Dia mengirimkan angin sebagai pembawa berita gembira dan agar kamu merasakan sebagian dari rahmat-Nya dan agar kapal dapat berlayar dengan perintah-Nya dan (juga) agar kamu dapat mencari sebagian dari karunia-Nya, dan agar kamu bersyukur.","enText":"And of His signs is that He sends the winds as bringers of good tidings and to let you taste His mercy and so the ships may sail at His command and so you may seek of His bounty, and perhaps you will be grateful.","readText":"wa min \u0101y\u0101tih\u012b ay yursilar-riy\u0101\u1e25a mubasysyir\u0101tiw wa liyu\u017c\u012bqakum mir ra\u1e25matih\u012b wa litajriyal-fulku bi`amrih\u012b wa litabtag\u1ee5 min fa\u1e0dlih\u012b wa la'allakum tasykur\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030046.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":47,"ayahText":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u0652 \u0627\u064e\u0631\u0652\u0633\u064e\u0644\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650\u0643\u064e \u0631\u064f\u0633\u064f\u0644\u064b\u0627 \u0627\u0650\u0644\u0670\u0649 \u0642\u064e\u0648\u0652\u0645\u0650\u0647\u0650\u0645\u0652 \u0641\u064e\u062c\u064e\u0627\u06e4\u0621\u064f\u0648\u0652\u0647\u064f\u0645\u0652 \u0628\u0650\u0627\u0644\u0652\u0628\u064e\u064a\u0651\u0650\u0646\u0670\u062a\u0650 \u0641\u064e\u0627\u0646\u0652\u062a\u064e\u0642\u064e\u0645\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u064e\u062c\u0652\u0631\u064e\u0645\u064f\u0648\u0652\u0627\u06d7 \u0648\u064e\u0643\u064e\u0627\u0646\u064e \u062d\u064e\u0642\u0651\u064b\u0627\u06d6 \u0639\u064e\u0644\u064e\u064a\u0652\u0646\u064e\u0627 \u0646\u064e\u0635\u0652\u0631\u064f \u0627\u0644\u0652\u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0652\u0646\u064e","indoText":"Dan sungguh, Kami telah mengutus sebelum engkau (Muhammad) beberapa orang rasul kepada kaumnya, mereka datang kepadanya dengan membawa keterangan-keterangan (yang cukup), lalu Kami melakukan pembalasan terhadap orang-orang yang berdosa. Dan merupakan hak Kami untuk menolong orang-orang yang beriman.","enText":"And We have already sent messengers before you to their peoples, and they came to them with clear evidences; then We took retribution from those who committed crimes, and incumbent upon Us was support of the believers.","readText":"wa laqad arsaln\u0101 ming qablika rusulan il\u0101 qaumihim fa j\u0101`\u1ee5hum bil-bayyin\u0101ti fantaqamn\u0101 minalla\u017c\u012bna ajram\u1ee5, wa k\u0101na \u1e25aqqan 'alain\u0101 na\u1e63rul-mu`min\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030047.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":48,"ayahText":"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u064a\u064f\u0631\u0652\u0633\u0650\u0644\u064f \u0627\u0644\u0631\u0651\u0650\u064a\u0670\u062d\u064e \u0641\u064e\u062a\u064f\u062b\u0650\u064a\u0652\u0631\u064f \u0633\u064e\u062d\u064e\u0627\u0628\u064b\u0627 \u0641\u064e\u064a\u064e\u0628\u0652\u0633\u064f\u0637\u064f\u0647\u0657 \u0641\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u06e4\u0621\u0650 \u0643\u064e\u064a\u0652\u0641\u064e \u064a\u064e\u0634\u064e\u0627\u06e4\u0621\u064f \u0648\u064e\u064a\u064e\u062c\u0652\u0639\u064e\u0644\u064f\u0647\u0657 \u0643\u0650\u0633\u064e\u0641\u064b\u0627 \u0641\u064e\u062a\u064e\u0631\u064e\u0649 \u0627\u0644\u0652\u0648\u064e\u062f\u0652\u0642\u064e \u064a\u064e\u062e\u0652\u0631\u064f\u062c\u064f \u0645\u0650\u0646\u0652 \u062e\u0650\u0644\u0670\u0644\u0650\u0647\u0656\u06da \u0641\u064e\u0627\u0650\u0630\u064e\u0627\u0653 \u0627\u064e\u0635\u064e\u0627\u0628\u064e \u0628\u0650\u0647\u0656 \u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u0634\u064e\u0627\u06e4\u0621\u064f \u0645\u0650\u0646\u0652 \u0639\u0650\u0628\u064e\u0627\u062f\u0650\u0647\u0656\u0653 \u0627\u0650\u0630\u064e\u0627 \u0647\u064f\u0645\u0652 \u064a\u064e\u0633\u0652\u062a\u064e\u0628\u0652\u0634\u0650\u0631\u064f\u0648\u0652\u0646\u064e\u06da","indoText":"Allah-lah yang mengirimkan angin, lalu angin itu menggerakkan awan dan Allah membentangkannya di langit menurut yang Dia kehendaki, dan menjadikannya bergumpal-gumpal, lalu engkau lihat hujan keluar dari celah-celahnya, maka apabila Dia menurunkannya kepada hamba-hamba-Nya yang Dia kehendaki tiba-tiba mereka bergembira.","enText":"It is Allah who sends the winds, and they stir the clouds and spread them in the sky however He wills, and He makes them fragments so you see the rain emerge from within them. And when He causes it to fall upon whom He wills of His servants, immediately they rejoice","readText":"all\u0101hulla\u017c\u012b yursilur-riy\u0101\u1e25a fa tu\u1e61\u012bru sa\u1e25\u0101ban fa yabsu\u1e6duh\u1ee5 fis-sam\u0101`i kaifa yasy\u0101`u wa yaj'aluh\u1ee5 kisafan fa taral-wadqa yakhruju min khil\u0101lih, fa i\u017c\u0101 a\u1e63\u0101ba bih\u012b may yasy\u0101`u min 'ib\u0101dih\u012b i\u017c\u0101 hum yastabsyir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030048.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":49,"ayahText":"\u0648\u064e\u0627\u0650\u0646\u0652 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650 \u0627\u064e\u0646\u0652 \u064a\u0651\u064f\u0646\u064e\u0632\u0651\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650\u0647\u0656 \u0644\u064e\u0645\u064f\u0628\u0652\u0644\u0650\u0633\u0650\u064a\u0652\u0646\u064e\u06da","indoText":"Padahal walaupun sebelum hujan diturunkan kepada mereka, mereka benar-benar telah berputus asa.","enText":"Although they were, before it was sent down upon them - before that, in despair.","readText":"wa ing k\u0101n\u1ee5 ming qabli ay yunazzala 'alaihim ming qablih\u012b lamublis\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030049.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":50,"ayahText":"\u0641\u064e\u0627\u0646\u0652\u0638\u064f\u0631\u0652 \u0627\u0650\u0644\u0670\u0653\u0649 \u0627\u0670\u062b\u0670\u0631\u0650 \u0631\u064e\u062d\u0652\u0645\u064e\u062a\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0643\u064e\u064a\u0652\u0641\u064e \u064a\u064f\u062d\u0652\u064a\u0650 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0628\u064e\u0639\u0652\u062f\u064e \u0645\u064e\u0648\u0652\u062a\u0650\u0647\u064e\u0627\u06d7 \u0627\u0650\u0646\u0651\u064e \u0630\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0645\u064f\u062d\u0652\u064a\u0650 \u0627\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u0670\u0649\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0639\u064e\u0644\u0670\u0649 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u0652\u0621\u064d \u0642\u064e\u062f\u0650\u064a\u0652\u0631\u064c","indoText":"Maka perhatikanlah bekas-bekas rahmat Allah, bagaimana Allah menghidupkan bumi setelah mati (kering). Sungguh, itu berarti Dia pasti (berkuasa) menghidupkan yang telah mati. Dan Dia Mahakuasa atas segala sesuatu.","enText":"So observe the effects of the mercy of Allah - how He gives life to the earth after its lifelessness. Indeed, that [same one] will give life to the dead, and He is over all things competent.","readText":"fan\u1e93ur il\u0101 \u0101\u1e61\u0101ri ra\u1e25matill\u0101hi kaifa yu\u1e25yil-ar\u1e0da ba'da mautih\u0101, inna \u017c\u0101lika lamu\u1e25yil maut\u0101, wa huwa 'al\u0101 kulli syai`ing qad\u012br","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030050.mp3","juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":51,"ayahText":"\u0648\u064e\u0644\u064e\u0649\u0655\u0650\u0646\u0652 \u0627\u064e\u0631\u0652\u0633\u064e\u0644\u0652\u0646\u064e\u0627 \u0631\u0650\u064a\u0652\u062d\u064b\u0627 \u0641\u064e\u0631\u064e\u0627\u064e\u0648\u0652\u0647\u064f \u0645\u064f\u0635\u0652\u0641\u064e\u0631\u0651\u064b\u0627 \u0644\u0651\u064e\u0638\u064e\u0644\u0651\u064f\u0648\u0652\u0627 \u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u0639\u0652\u062f\u0650\u0647\u0656 \u064a\u064e\u0643\u0652\u0641\u064f\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan sungguh, jika Kami mengirimkan angin lalu mereka melihat (tumbuh-tumbuhan itu) menjadi kuning (kering), niscaya setelah itu mereka tetap ingkar.","enText":"But if We should send a [bad] wind and they saw [their crops] turned yellow, they would remain thereafter disbelievers.","readText":"wa la`in arsaln\u0101 r\u012b\u1e25an fa ra`auhu mu\u1e63farral la\u1e93all\u1ee5 mim ba'dih\u012b yakfur\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030051.mp3","juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":52,"ayahText":"\u0641\u064e\u0627\u0650\u0646\u0651\u064e\u0643\u064e \u0644\u064e\u0627 \u062a\u064f\u0633\u0652\u0645\u0650\u0639\u064f \u0627\u0644\u0652\u0645\u064e\u0648\u0652\u062a\u0670\u0649 \u0648\u064e\u0644\u064e\u0627 \u062a\u064f\u0633\u0652\u0645\u0650\u0639\u064f \u0627\u0644\u0635\u0651\u064f\u0645\u0651\u064e \u0627\u0644\u062f\u0651\u064f\u0639\u064e\u0627\u06e4\u0621\u064e \u0627\u0650\u0630\u064e\u0627 \u0648\u064e\u0644\u0651\u064e\u0648\u0652\u0627 \u0645\u064f\u062f\u0652\u0628\u0650\u0631\u0650\u064a\u0652\u0646\u064e","indoText":"Maka sungguh, engkau tidak akan sanggup menjadikan orang-orang yang mati itu dapat mendengar, dan menjadikan orang-orang yang tuli dapat mendengar seruan, apabila mereka berpaling ke belakang.","enText":"So indeed, you will not make the dead hear, nor will you make the deaf hear the call when they turn their backs, retreating.","readText":"fa innaka l\u0101 tusmi'ul-maut\u0101 wa l\u0101 tusmi'u\u1e63-\u1e63ummad-du'\u0101`a i\u017c\u0101 wallau mudbir\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030052.mp3","juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":53,"ayahText":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0627\u064e\u0646\u0652\u062a\u064e \u0628\u0650\u0647\u0670\u062f\u0650 \u0627\u0644\u0652\u0639\u064f\u0645\u0652\u064a\u0650 \u0639\u064e\u0646\u0652 \u0636\u064e\u0644\u0670\u0644\u064e\u062a\u0650\u0647\u0650\u0645\u0652\u06d7 \u0627\u0650\u0646\u0652 \u062a\u064f\u0633\u0652\u0645\u0650\u0639\u064f \u0627\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u0652 \u064a\u0651\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0627\u0670\u064a\u0670\u062a\u0650\u0646\u064e\u0627 \u0641\u064e\u0647\u064f\u0645\u0652 \u0645\u0651\u064f\u0633\u0652\u0644\u0650\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"Dan engkau tidak akan dapat memberi petunjuk kepada orang-orang yang buta (mata hatinya) dari kesesatannya. Dan engkau tidak dapat memperdengarkan (petunjuk Tuhan) kecuali kepada orang-orang yang beriman dengan ayat-ayat Kami, maka mereka itulah orang-orang yang berserah diri (kepada Kami).","enText":"And you cannot guide the blind away from their error. You will only make hear those who believe in Our verses so they are Muslims [in submission to Allah].","readText":"wa m\u0101 anta bih\u0101dil-'umyi 'an \u1e0dal\u0101latihim, in tusmi'u ill\u0101 may yu`minu bi`\u0101y\u0101tin\u0101 fa hum muslim\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/030053.mp3","juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"verseId":54,"ayahText":"\u06de \u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u062e\u064e\u0644\u064e\u0642\u064e\u0643\u064f\u0645\u0652 \u0645\u0651\u0650\u0646\u0652 \u0636\u064e\u0639\u0652\u0641\u064d \u062b\u064f\u0645\u0651\u064e \u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u0639\u0652\u062f\u0650 \u0636\u064e\u0639\u0652\u0641\u064d \u0642\u064f\u0648\u0651\u064e\u0629\u064b \u062b\u064f\u0645\u0651\u064e \u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u0639\u0652\u062f\u0650 \u0642\u064f\u0648\u0651\u064e\u0629\u064d \u0636\u064e\u0639\u0652\u0641\u064b\u0627 \u0648\u0651\u064e\u0634\u064e\u064a\u0652\u0628\u064e\u0629\u064b \u06d7\u064a\u064e\u062e\u0652\u0644\u064f\u0642\u064f \u0645\u064e\u0627 \u064a\u064e\u0634\u064e\u0627\u06e4\u0621\u064f\u06da \u0648\u064e\u0647\u064f\u0648\u064e \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0652\u0645\u064f \u0627\u0644\u0652\u0642\u064e\u062f\u0650\u064a\u0652\u0631\u064f","indoText":"Allah-lah yang menciptakan kamu dari keadaan lemah, kemudian Dia menjadikan (kamu) setelah keadaan lemah itu menjadi kuat, kemudian Dia menjadikan (kamu) setelah kuat itu lemah (kembali) dan beruban. Dia menciptakan apa yang Dia kehendaki. Dan Dia Maha Mengetahui, Mahakuasa.","enText":"Allah is the one who created you from weakness, then made after weakness strength, then made after strength weakness and white hair. He creates what He wills, and He is the Knowing, the Competent.","readText":"all\u0101hulla\u017c\u012b khalaqakum min \u1e0da'fin \u1e61umma ja'ala mim ba'di \u1e0da'fing quwwatan \u1e61umma ja'ala mim ba'di quwwatin \u1e0da'faw w