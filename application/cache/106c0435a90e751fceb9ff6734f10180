l\u0101h, innall\u0101ha k\u0101na 'al\u012bman \u1e25ak\u012bm\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/076030.mp3","juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"verseId":31,"ayahText":"\u064a\u0651\u064f\u062f\u0652\u062e\u0650\u0644\u064f \u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u0634\u064e\u0627\u06e4\u0621\u064f \u0641\u0650\u064a\u0652 \u0631\u064e\u062d\u0652\u0645\u064e\u062a\u0650\u0647\u0656\u06d7 \u0648\u064e\u0627\u0644\u0638\u0651\u0670\u0644\u0650\u0645\u0650\u064a\u0652\u0646\u064e \u0627\u064e\u0639\u064e\u062f\u0651\u064e \u0644\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064b\u0627 \u0627\u064e\u0644\u0650\u064a\u0652\u0645\u064b\u0627","indoText":"Dia memasukkan siapa pun yang Dia kehendaki ke dalam rahmat-Nya (surga). Adapun bagi orang-orang zalim disediakan-Nya azab yang pedih.","enText":"He admits whom He wills into His mercy; but the wrongdoers - He has prepared for them a painful punishment.","readText":"yudkhilu may yasy\u0101`u f\u012b ra\u1e25matih, wa\u1e93-\u1e93\u0101lim\u012bna a'adda lahum 'a\u017c\u0101ban al\u012bm\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/076031.mp3","juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false}]}";}