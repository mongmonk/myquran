sy_64kbps\/013021.mp3","juz":13,"manzil":3,"page":252,"ruku":207,"hizbQuarter":101,"sajda":false},{"verseId":22,"ayahText":"\u0648\u064e\u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0635\u064e\u0628\u064e\u0631\u064f\u0648\u0627 \u0627\u0628\u0652\u062a\u0650\u063a\u064e\u0627\u06e4\u0621\u064e \u0648\u064e\u062c\u0652\u0647\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u0652 \u0648\u064e\u0627\u064e\u0642\u064e\u0627\u0645\u064f\u0648\u0627 \u0627\u0644\u0635\u0651\u064e\u0644\u0670\u0648\u0629\u064e \u0648\u064e\u0627\u064e\u0646\u0652\u0641\u064e\u0642\u064f\u0648\u0652\u0627 \u0645\u0650\u0645\u0651\u064e\u0627 \u0631\u064e\u0632\u064e\u0642\u0652\u0646\u0670\u0647\u064f\u0645\u0652 \u0633\u0650\u0631\u0651\u064b\u0627 \u0648\u0651\u064e\u0639\u064e\u0644\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u064b \u0648\u0651\u064e\u064a\u064e\u062f\u0652\u0631\u064e\u0621\u064f\u0648\u0652\u0646\u064e \u0628\u0650\u0627\u0644\u0652\u062d\u064e\u0633\u064e\u0646\u064e\u0629\u0650 \u0627\u0644\u0633\u0651\u064e\u064a\u0651\u0650\u0626\u064e\u0629\u064e \u0627\u064f\u0648\u0644\u0670\u06e4\u0649\u0655\u0650\u0643\u064e \u0644\u064e\u0647\u064f\u0645\u0652 \u0639\u064f\u0642\u0652\u0628\u064e\u0649 \u0627\u0644\u062f\u0651\u064e\u0627\u0631\u0650\u06d9","indoText":"Dan orang yang sabar karena mengharap keridaan Tuhannya, melaksanakan salat, dan menginfakkan sebagian rezeki yang Kami berikan kepada mereka, secara sembunyi atau terang-terangan serta menolak kejahatan dengan kebaikan; orang itulah yang men-dapat tempat kesudahan (yang baik),","enText":"And those who are patient, seeking the countenance of their Lord, and establish prayer and spend from what We have provided for them secretly and publicly and prevent evil with good - those will have the good consequence of [this] home -","readText":"walla\u017c\u012bna \u1e63abarubtig\u0101`a waj-hi rabbihim wa aq\u0101mu\u1e63-\u1e63al\u0101ta wa anfaq\u1ee5 mimm\u0101 razaqn\u0101hum sirraw wa 'al\u010