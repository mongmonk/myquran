asy_64kbps\/037026.mp3","juz":23,"manzil":6,"page":447,"ruku":387,"hizbQuarter":179,"sajda":false},{"verseId":27,"ayahText":"\u0648\u064e\u0627\u064e\u0642\u0652\u0628\u064e\u0644\u064e \u0628\u064e\u0639\u0652\u0636\u064f\u0647\u064f\u0645\u0652 \u0639\u064e\u0644\u0670\u0649 \u0628\u064e\u0639\u0652\u0636\u064d \u064a\u0651\u064e\u062a\u064e\u0633\u064e\u0627\u06e4\u0621\u064e\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dan sebagian mereka menghadap kepada sebagian yang lain saling berbantah-bantahan.","enText":"And they will approach one another blaming each other.","readText":"wa aqbala ba'\u1e0duhum 'al\u0101 ba'\u1e0diy yatas\u0101`al\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/037027.mp3","juz":23,"manzil":6,"page":447,"ruku":387,"hizbQuarter":179,"sajda":false},{"verseId":28,"ayahText":"\u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0653\u0627 \u0627\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u0652 \u0643\u064f\u0646\u0652\u062a\u064f\u0645\u0652 \u062a\u064e\u0623\u0652\u062a\u064f\u0648\u0652\u0646\u064e\u0646\u064e\u0627 \u0639\u064e\u0646\u0650 \u0627\u0644\u0652\u064a\u064e\u0645\u0650\u064a\u0652\u0646\u0650","indoText":"Sesungguhnya (pengikut-pengikut) mereka berkata (kepada pemimpin-pemimpin mereka), \u201cKamulah yang dahulu datang kepada kami dari kanan.\u201d","enText":"They will say, \"Indeed, you used to come at us from the right.\"","readText":"q\u0101l\u016b innakum kuntum ta`t\u1ee5nan\u0101 'anil-yam\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/037028.mp3","juz":23,"manzil":6,"page":447,"ruku":387,"hizbQuarter":179,"sajda":false},{"verseId":29,"ayahText":"\u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0627 \u0628\u064e\u0644\u0652 \u0644\u0651\u064e\u0645\u0652 \u062a\u064e\u0643\u064f\u0648\u0652\u0646\u064f\u0648\u0652\u0627 \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u0650\u064a\u0652\u0646\u064e\u06da","indoText":"(Pemimpin-pemimpin) mereka menjawab, \u201c(Tidak), bahkan kamulah yang tidak (mau) menja