s\/041003.mp3","juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"verseId":4,"ayahText":"\u0628\u064e\u0634\u0650\u064a\u0652\u0631\u064b\u0627 \u0648\u0651\u064e\u0646\u064e\u0630\u0650\u064a\u0652\u0631\u064b\u0627\u06da \u0641\u064e\u0627\u064e\u0639\u0652\u0631\u064e\u0636\u064e \u0627\u064e\u0643\u0652\u062b\u064e\u0631\u064f\u0647\u064f\u0645\u0652 \u0641\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u064a\u064e\u0633\u0652\u0645\u064e\u0639\u064f\u0648\u0652\u0646\u064e","indoText":"yang membawa berita gembira dan peringatan, tetapi kebanyakan mereka berpaling (darinya) serta tidak mendengarkan.","enText":"As a giver of good tidings and a warner; but most of them turn away, so they do not hear.","readText":"basy\u012braw wa na\u017c\u012br\u0101, fa a'ra\u1e0da ak\u1e61aruhum fa hum l\u0101 yasma'\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041004.mp3","juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"verseId":5,"ayahText":"\u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0627 \u0642\u064f\u0644\u064f\u0648\u0652\u0628\u064f\u0646\u064e\u0627 \u0641\u0650\u064a\u0652\u0653 \u0627\u064e\u0643\u0650\u0646\u0651\u064e\u0629\u064d \u0645\u0650\u0651\u0645\u0651\u064e\u0627 \u062a\u064e\u062f\u0652\u0639\u064f\u0648\u0652\u0646\u064e\u0627\u0653 \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0641\u0650\u064a\u0652\u0653 \u0627\u0670\u0630\u064e\u0627\u0646\u0650\u0646\u064e\u0627 \u0648\u064e\u0642\u0652\u0631\u064c \u0648\u0651\u064e\u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u064a\u0652\u0646\u0650\u0646\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u0652\u0646\u0650\u0643\u064e \u062d\u0650\u062c\u064e\u0627\u0628\u064c \u0641\u064e\u0627\u0639\u0652\u0645\u064e\u0644\u0652 \u0627\u0650\u0646\u0651\u064e\u0646\u064e\u0627 \u0639\u0670\u0645\u0650\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dan mereka berkata, \u201cHati kami sudah tertutup dari apa yang engkau seru kami kepadanya dan telinga kami sudah tersumbat, dan di antara kami dan engkau ada dinding, karena itu lakukanlah (sesuai kehendakmu), sesungguhnya kami akan melakukan (sesuai kehendak kami).\u201d","enText":"And they say, \"Our hearts are within coverings from that to which you invite us, and in our ears is deafness, and between us and you is a partition, so work; indeed, we are working.\"","readText":"wa q\u0101l\u1ee5 qul\u1ee5bun\u0101 f\u012b akinnatim mimm\u0101 tad'\u1ee5n\u0101 ilaihi wa f\u012b \u0101\u017c\u0101nin\u0101 waqruw wa mim bainin\u0101 wa bainika \u1e25ij\u0101bun fa'mal innan\u0101 '\u0101mil\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041005.mp3","juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"verseId":6,"ayahText":"\u0642\u064f\u0644\u0652 \u0627\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0627\u064e\u0646\u064e\u0627\u06df \u0628\u064e\u0634\u064e\u0631\u064c \u0645\u0651\u0650\u062b\u0652\u0644\u064f\u0643\u064f\u0645\u0652 \u064a\u064f\u0648\u0652\u062d\u0670\u0649\u0653 \u0627\u0650\u0644\u064e\u064a\u0651\u064e \u0627\u064e\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0627\u0650\u0644\u0670\u0647\u064f\u0643\u064f\u0645\u0652 \u0627\u0650\u0644\u0670\u0647\u064c \u0648\u0651\u064e\u0627\u062d\u0650\u062f\u064c \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0642\u0650\u064a\u0652\u0645\u064f\u0648\u0652\u0653\u0627 \u0627\u0650\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0627\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064f\u0648\u0652\u0647\u064f \u06d7\u0648\u064e\u0648\u064e\u064a\u0652\u0644\u064c \u0644\u0651\u0650\u0644\u0652\u0645\u064f\u0634\u0652\u0631\u0650\u0643\u0650\u064a\u0652\u0646\u064e\u06d9","indoText":"Katakanlah (Muhammad), \u201cAku ini hanyalah seorang manusia seperti kamu, yang diwahyukan kepadaku bahwa Tuhan kamu adalah Tuhan Yang Maha Esa, karena itu tetaplah kamu (beribadah) kepada-Nya dan mohonlah ampunan kepada-Nya. Dan celakalah bagi orang-orang yang mempersekutukan-(Nya),","enText":"Say, O [Muhammad], \"I am only a man like you to whom it has been revealed that your god is but one God; so take a straight course to Him and seek His forgiveness.\" And woe to those who associate others with Allah -","readText":"qul innam\u0101 ana basyarum mi\u1e61lukum y\u1ee5\u1e25\u0101 ilayya annam\u0101 il\u0101hukum il\u0101huw w\u0101\u1e25idun fastaq\u012bm\u016b ilaihi wastagfir\u1ee5h, wa wailul lil-musyrik\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041006.mp3","juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"verseId":7,"ayahText":"\u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u0652\u062a\u064f\u0648\u0652\u0646\u064e \u0627\u0644\u0632\u0651\u064e\u0643\u0670\u0648\u0629\u064e \u0648\u064e\u0647\u064f\u0645\u0652 \u0628\u0650\u0627\u0644\u0652\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u0647\u064f\u0645\u0652 \u0643\u0670\u0641\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"(yaitu) orang-orang yang tidak menunaikan zakat dan mereka ingkar terhadap kehidupan akhirat.","enText":"Those who do not give zakah, and in the Hereafter they are disbelievers.","readText":"alla\u017c\u012bna l\u0101 yu`t\u1ee5naz-zak\u0101ta wa hum bil-\u0101khirati hum k\u0101fir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041007.mp3","juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"verseId":8,"ayahText":"\u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0652\u0627 \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627 \u0627\u0644\u0635\u0651\u0670\u0644\u0650\u062d\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u0652 \u0627\u064e\u062c\u0652\u0631\u064c \u063a\u064e\u064a\u0652\u0631\u064f \u0645\u064e\u0645\u0652\u0646\u064f\u0648\u0652\u0646\u064d","indoText":"Sesungguhnya orang-orang yang beriman dan mengerjakan kebajikan, mereka mendapat pahala yang tidak ada putus-putusnya.\u201d","enText":"Indeed, those who believe and do righteous deeds - for them is a reward uninterrupted.","readText":"innalla\u017c\u012bna \u0101man\u1ee5 wa 'amilu\u1e63-\u1e63\u0101li\u1e25\u0101ti lahum ajrun gairu mamn\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041008.mp3","juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"verseId":9,"ayahText":"\u06de \u0642\u064f\u0644\u0652 \u0627\u064e\u0649\u0655\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u0652 \u0644\u064e\u062a\u064e\u0643\u0652\u0641\u064f\u0631\u064f\u0648\u0652\u0646\u064e \u0628\u0650\u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u062e\u064e\u0644\u064e\u0642\u064e \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0641\u0650\u064a\u0652 \u064a\u064e\u0648\u0652\u0645\u064e\u064a\u0652\u0646\u0650 \u0648\u064e\u062a\u064e\u062c\u0652\u0639\u064e\u0644\u064f\u0648\u0652\u0646\u064e \u0644\u064e\u0647\u0657\u0653 \u0627\u064e\u0646\u0652\u062f\u064e\u0627\u062f\u064b\u0627 \u06d7\u0630\u0670\u0644\u0650\u0643\u064e \u0631\u064e\u0628\u0651\u064f \u0627\u0644\u0652\u0639\u0670\u0644\u064e\u0645\u0650\u064a\u0652\u0646\u064e \u06da","indoText":"Katakanlah, \u201cPantaskah kamu ingkar kepada Tuhan yang menciptakan bumi dalam dua masa dan kamu adakan pula sekutu-sekutu bagi-Nya? Itulah Tuhan seluruh alam.\u201d","enText":"Say, \"Do you indeed disbelieve in He who created the earth in two days and attribute to Him equals? That is the Lord of the worlds.\"","readText":"qul a innakum latakfur\u1ee5na billa\u017c\u012b khalaqal-ar\u1e0da f\u012b yaumaini wa taj'al\u1ee5na lah\u016b and\u0101d\u0101, \u017c\u0101lika rabbul-'\u0101lam\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041009.mp3","juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":10,"ayahText":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0641\u0650\u064a\u0652\u0647\u064e\u0627 \u0631\u064e\u0648\u064e\u0627\u0633\u0650\u064a\u064e \u0645\u0650\u0646\u0652 \u0641\u064e\u0648\u0652\u0642\u0650\u0647\u064e\u0627 \u0648\u064e\u0628\u0670\u0631\u064e\u0643\u064e \u0641\u0650\u064a\u0652\u0647\u064e\u0627 \u0648\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e \u0641\u0650\u064a\u0652\u0647\u064e\u0627\u0653 \u0627\u064e\u0642\u0652\u0648\u064e\u0627\u062a\u064e\u0647\u064e\u0627 \u0641\u0650\u064a\u0652\u0653 \u0627\u064e\u0631\u0652\u0628\u064e\u0639\u064e\u0629\u0650 \u0627\u064e\u064a\u0651\u064e\u0627\u0645\u064d\u06d7 \u0633\u064e\u0648\u064e\u0627\u06e4\u0621\u064b \u0644\u0651\u0650\u0644\u0633\u0651\u064e\u0627\u06e4\u0649\u0655\u0650\u0644\u0650\u064a\u0652\u0646\u064e","indoText":"Dan Dia ciptakan padanya gunung-gunung yang kokoh di atasnya. Dan kemudian Dia berkahi, dan Dia tentukan makanan-makanan (bagi penghuni)nya dalam empat masa, memadai untuk (memenuhi kebutuhan) mereka yang memerlukannya.","enText":"And He placed on the earth firmly set mountains over its surface, and He blessed it and determined therein its [creatures'] sustenance in four days without distinction - for [the information] of those who ask.","readText":"wa ja'ala f\u012bh\u0101 raw\u0101siya min fauqih\u0101 wa b\u0101raka f\u012bh\u0101 wa qaddara f\u012bh\u0101 aqw\u0101tah\u0101 f\u012b arba'ati ayy\u0101m, saw\u0101`al lis-s\u0101`il\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041010.mp3","juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":11,"ayahText":"\u062b\u064f\u0645\u0651\u064e \u0627\u0633\u0652\u062a\u064e\u0648\u0670\u0649\u0653 \u0627\u0650\u0644\u064e\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u06e4\u0621\u0650 \u0648\u064e\u0647\u0650\u064a\u064e \u062f\u064f\u062e\u064e\u0627\u0646\u064c \u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0644\u064e\u0647\u064e\u0627 \u0648\u064e\u0644\u0650\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0627\u0626\u0652\u062a\u0650\u064a\u064e\u0627 \u0637\u064e\u0648\u0652\u0639\u064b\u0627 \u0627\u064e\u0648\u0652 \u0643\u064e\u0631\u0652\u0647\u064b\u0627\u06d7 \u0642\u064e\u0627\u0644\u064e\u062a\u064e\u0627\u0653 \u0627\u064e\u062a\u064e\u064a\u0652\u0646\u064e\u0627 \u0637\u064e\u0627\u06e4\u0649\u0655\u0650\u0639\u0650\u064a\u0652\u0646\u064e","indoText":"Kemudian Dia menuju ke langit dan (langit) itu masih berupa asap, lalu Dia berfirman kepadanya dan kepada bumi, \u201cDatanglah kamu berdua menurut perintah-Ku dengan patuh atau terpaksa.\u201d Keduanya menjawab, \u201cKami datang dengan patuh.\u201d","enText":"Then He directed Himself to the heaven while it was smoke and said to it and to the earth, \"Come [into being], willingly or by compulsion.\" They said, \"We have come willingly.\"","readText":"\u1e61ummastaw\u0101 ilas-sam\u0101`i wa hiya dukh\u0101nun fa q\u0101la lah\u0101 wa lil-ar\u1e0di`tiy\u0101 \u1e6dau'an au karh\u0101, q\u0101lat\u0101 atain\u0101 \u1e6d\u0101`i'\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041011.mp3","juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":12,"ayahText":"\u0641\u064e\u0642\u064e\u0636\u0670\u0649\u0647\u064f\u0646\u0651\u064e \u0633\u064e\u0628\u0652\u0639\u064e \u0633\u064e\u0645\u0670\u0648\u0670\u062a\u064d \u0641\u0650\u064a\u0652 \u064a\u064e\u0648\u0652\u0645\u064e\u064a\u0652\u0646\u0650 \u0648\u064e\u0627\u064e\u0648\u0652\u062d\u0670\u0649 \u0641\u0650\u064a\u0652 \u0643\u064f\u0644\u0651\u0650 \u0633\u064e\u0645\u064e\u0627\u06e4\u0621\u064d \u0627\u064e\u0645\u0652\u0631\u064e\u0647\u064e\u0627 \u06d7\u0648\u064e\u0632\u064e\u064a\u0651\u064e\u0646\u0651\u064e\u0627 \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u06e4\u0621\u064e \u0627\u0644\u062f\u0651\u064f\u0646\u0652\u064a\u064e\u0627 \u0628\u0650\u0645\u064e\u0635\u064e\u0627\u0628\u0650\u064a\u0652\u062d\u064e\u06d6 \u0648\u064e\u062d\u0650\u0641\u0652\u0638\u064b\u0627 \u06d7\u0630\u0670\u0644\u0650\u0643\u064e \u062a\u064e\u0642\u0652\u062f\u0650\u064a\u0652\u0631\u064f \u0627\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0652\u0632\u0650 \u0627\u0644\u0652\u0639\u064e\u0644\u0650\u064a\u0652\u0645\u0650","indoText":"Lalu diciptakan-Nya tujuh langit dalam dua masa dan pada setiap langit Dia mewahyukan urusan masing-masing. Kemudian langit yang dekat (dengan bumi), Kami hiasi dengan bintang-bintang, dan (Kami ciptakan itu) untuk memelihara. Demikianlah ketentuan (Allah) Yang Mahaperkasa, Maha Mengetahui.","enText":"And He completed them as seven heavens within two days and inspired in each heaven its command. And We adorned the nearest heaven with lamps and as protection. That is the determination of the Exalted in Might, the Knowing.","readText":"fa qa\u1e0d\u0101hunna sab'a sam\u0101w\u0101tin f\u012b yaumaini wa au\u1e25\u0101 f\u012b kulli sam\u0101`in amrah\u0101, wa zayyannas-sam\u0101`ad-dun-y\u0101 bima\u1e63\u0101b\u012b\u1e25a wa \u1e25if\u1e93\u0101, \u017c\u0101lika taqd\u012brul-'az\u012bzil-'al\u012bm","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041012.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":13,"ayahText":"\u0641\u064e\u0627\u0650\u0646\u0652 \u0627\u064e\u0639\u0652\u0631\u064e\u0636\u064f\u0648\u0652\u0627 \u0641\u064e\u0642\u064f\u0644\u0652 \u0627\u064e\u0646\u0652\u0630\u064e\u0631\u0652\u062a\u064f\u0643\u064f\u0645\u0652 \u0635\u0670\u0639\u0650\u0642\u064e\u0629\u064b \u0645\u0650\u0651\u062b\u0652\u0644\u064e \u0635\u0670\u0639\u0650\u0642\u064e\u0629\u0650 \u0639\u064e\u0627\u062f\u064d \u0648\u0651\u064e\u062b\u064e\u0645\u064f\u0648\u0652\u062f\u064e \u06d7","indoText":"Jika mereka berpaling maka katakanlah, \u201cAku telah memperingatkan kamu akan (bencana) petir seperti petir yang menimpa kaum \u2019Ad dan kaum Samud.\u201d","enText":"But if they turn away, then say, \"I have warned you of a thunderbolt like the thunderbolt [that struck] 'Aad and Thamud.","readText":"fa in a'ra\u1e0d\u1ee5 fa qul an\u017cartukum \u1e63\u0101'iqatam mi\u1e61la \u1e63\u0101'iqati '\u0101diw wa \u1e61am\u1ee5d","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041013.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":14,"ayahText":"\u0627\u0650\u0630\u0652 \u062c\u064e\u0627\u06e4\u0621\u064e\u062a\u0652\u0647\u064f\u0645\u064f \u0627\u0644\u0631\u0651\u064f\u0633\u064f\u0644\u064f \u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u064a\u0652\u0646\u0650 \u0627\u064e\u064a\u0652\u062f\u0650\u064a\u0652\u0647\u0650\u0645\u0652 \u0648\u064e\u0645\u0650\u0646\u0652 \u062e\u064e\u0644\u0652\u0641\u0650\u0647\u0650\u0645\u0652 \u0627\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0639\u0652\u0628\u064f\u062f\u064f\u0648\u0652\u0653\u0627 \u0627\u0650\u0644\u0651\u064e\u0627 \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u06d7\u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0627 \u0644\u064e\u0648\u0652 \u0634\u064e\u0627\u06e4\u0621\u064e \u0631\u064e\u0628\u0651\u064f\u0646\u064e\u0627 \u0644\u064e\u0627\u064e\u0646\u0652\u0632\u064e\u0644\u064e \u0645\u064e\u0644\u0670\u06e4\u0649\u0655\u0650\u0643\u064e\u0629\u064b \u0641\u064e\u0627\u0650\u0646\u0651\u064e\u0627 \u0628\u0650\u0645\u064e\u0627\u0653 \u0627\u064f\u0631\u0652\u0633\u0650\u0644\u0652\u062a\u064f\u0645\u0652 \u0628\u0650\u0647\u0656 \u0643\u0670\u0641\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Ketika para rasul datang kepada mereka dari depan dan dari belakang mereka (dengan menyerukan), \u201cJanganlah kamu menyembah selain Allah.\u201d Mereka menjawab, \u201cKalau Tuhan kami menghendaki tentu Dia menurunkan malaikat-malaikat-Nya, maka sesungguhnya kami mengingkari wahyu yang engkau diutus menyampaikannya.\u201d","enText":"[That occurred] when the messengers had come to them before them and after them, [saying], \"Worship not except Allah.\" They said, \"If our Lord had willed, He would have sent down the angels, so indeed we, in that with which you have been sent, are disbelievers.\"","readText":"i\u017c j\u0101`at-humur-rusulu mim baini aid\u012bhim wa min khalfihim all\u0101 ta'bud\u016b illall\u0101h, q\u0101l\u1ee5 lau sy\u0101`a rabbun\u0101 la`anzala mal\u0101`ikatan fa inn\u0101 bim\u0101 ursiltum bih\u012b k\u0101fir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041014.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":15,"ayahText":"\u0641\u064e\u0627\u064e\u0645\u0651\u064e\u0627 \u0639\u064e\u0627\u062f\u064c \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0643\u0652\u0628\u064e\u0631\u064f\u0648\u0652\u0627 \u0641\u0650\u0649 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0628\u0650\u063a\u064e\u064a\u0652\u0631\u0650 \u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0627 \u0645\u064e\u0646\u0652 \u0627\u064e\u0634\u064e\u062f\u0651\u064f \u0645\u0650\u0646\u0651\u064e\u0627 \u0642\u064f\u0648\u0651\u064e\u0629\u064b \u06d7 \u0627\u064e\u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0631\u064e\u0648\u0652\u0627 \u0627\u064e\u0646\u0651\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u0645\u0652 \u0647\u064f\u0648\u064e \u0627\u064e\u0634\u064e\u062f\u0651\u064f \u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0642\u064f\u0648\u0651\u064e\u0629\u064b \u06d7 \u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0628\u0650\u0627\u0670\u064a\u0670\u062a\u0650\u0646\u064e\u0627 \u064a\u064e\u062c\u0652\u062d\u064e\u062f\u064f\u0648\u0652\u0646\u064e","indoText":"Maka adapun kaum \u2018Ad, mereka menyombongkan diri di bumi tanpa (mengindahkan) kebenaran dan mereka berkata, \u201cSiapakah yang lebih hebat kekuatannya dari kami?\u201d Tidakkah mereka memperhatikan bahwa sesungguhnya Allah yang menciptakan mereka. Dia lebih hebat kekuatan-Nya dari mereka? Dan mereka telah mengingkari tanda-tanda (kebesaran) Kami.","enText":"As for 'Aad, they were arrogant upon the earth without right and said, \"Who is greater than us in strength?\" Did they not consider that Allah who created them was greater than them in strength? But they were rejecting Our signs.","readText":"fa amm\u0101 '\u0101dun fastakbar\u1ee5 fil-ar\u1e0di bigairil-\u1e25aqqi wa q\u0101l\u1ee5 man asyaddu minn\u0101 quwwah, a wa lam yarau annall\u0101halla\u017c\u012b khalaqahum huwa asyaddu min-hum quwwah, wa k\u0101n\u1ee5 bi`\u0101y\u0101tin\u0101 yaj-\u1e25ad\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041015.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":16,"ayahText":"\u0641\u064e\u0627\u064e\u0631\u0652\u0633\u064e\u0644\u0652\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0631\u0650\u064a\u0652\u062d\u064b\u0627 \u0635\u064e\u0631\u0652\u0635\u064e\u0631\u064b\u0627 \u0641\u0650\u064a\u0652\u0653 \u0627\u064e\u064a\u0651\u064e\u0627\u0645\u064d \u0646\u0651\u064e\u062d\u0650\u0633\u064e\u0627\u062a\u064d \u0644\u0651\u0650\u0646\u064f\u0630\u0650\u064a\u0652\u0642\u064e\u0647\u064f\u0645\u0652 \u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0627\u0644\u0652\u062e\u0650\u0632\u0652\u064a\u0650 \u0641\u0650\u0649 \u0627\u0644\u0652\u062d\u064e\u064a\u0670\u0648\u0629\u0650 \u0627\u0644\u062f\u0651\u064f\u0646\u0652\u064a\u064e\u0627 \u06d7\u0648\u064e\u0644\u064e\u0639\u064e\u0630\u064e\u0627\u0628\u064f \u0627\u0644\u0652\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u0627\u064e\u062e\u0652\u0632\u0670\u0649 \u0648\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u064a\u064f\u0646\u0652\u0635\u064e\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Maka Kami tiupkan angin yang sangat bergemuruh kepada mereka dalam beberapa hari yang nahas, karena Kami ingin agar mereka itu merasakan siksaan yang menghinakan dalam kehidupan di dunia. Sedangkan azab akhirat pasti lebih menghinakan dan mereka tidak diberi pertolongan.","enText":"So We sent upon them a screaming wind during days of misfortune to make them taste the punishment of disgrace in the worldly life; but the punishment of the Hereafter is more disgracing, and they will not be helped.","readText":"fa arsaln\u0101 'alaihim r\u012b\u1e25an \u1e63ar\u1e63aran f\u012b ayy\u0101min na\u1e25is\u0101til linu\u017c\u012bqahum 'a\u017c\u0101bal-khizyi fil-\u1e25ay\u0101tid-dun-y\u0101, wa la'a\u017c\u0101bul-\u0101khirati akhz\u0101 wa hum l\u0101 yun\u1e63ar\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041016.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":17,"ayahText":"\u0648\u064e\u0627\u064e\u0645\u0651\u064e\u0627 \u062b\u064e\u0645\u064f\u0648\u0652\u062f\u064f \u0641\u064e\u0647\u064e\u062f\u064e\u064a\u0652\u0646\u0670\u0647\u064f\u0645\u0652 \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u062d\u064e\u0628\u0651\u064f\u0648\u0627 \u0627\u0644\u0652\u0639\u064e\u0645\u0670\u0649 \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0652\u0647\u064f\u062f\u0670\u0649 \u0641\u064e\u0627\u064e\u062e\u064e\u0630\u064e\u062a\u0652\u0647\u064f\u0645\u0652 \u0635\u0670\u0639\u0650\u0642\u064e\u0629\u064f \u0627\u0644\u0652\u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0627\u0644\u0652\u0647\u064f\u0648\u0652\u0646\u0650 \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u064a\u064e\u0643\u0652\u0633\u0650\u0628\u064f\u0648\u0652\u0646\u064e \u06da","indoText":"Dan adapun kaum Samud, mereka telah Kami beri petunjuk tetapi mereka lebih menyukai kebutaan (kesesatan) daripada petunjuk itu, maka mereka disambar petir sebagai azab yang menghinakan disebabkan apa yang telah mereka kerjakan.","enText":"And as for Thamud, We guided them, but they preferred blindness over guidance, so the thunderbolt of humiliating punishment seized them for what they used to earn.","readText":"wa amm\u0101 \u1e61am\u1ee5du fa hadain\u0101hum fasta\u1e25abbul-'am\u0101 'alal-hud\u0101 fa akha\u017cat-hum \u1e63\u0101'iqatul-'a\u017c\u0101bil-h\u1ee5ni bim\u0101 k\u0101n\u1ee5 yaksib\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041017.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":18,"ayahText":"\u0648\u064e\u0646\u064e\u062c\u0651\u064e\u064a\u0652\u0646\u064e\u0627 \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u0670\u0645\u064e\u0646\u064f\u0648\u0652\u0627 \u0648\u064e\u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u064a\u064e\u062a\u0651\u064e\u0642\u064f\u0648\u0652\u0646\u064e","indoText":"Dan Kami selamatkan orang-orang yang beriman karena mereka adalah orang-orang yang bertakwa.","enText":"And We saved those who believed and used to fear Allah.","readText":"wa najjainalla\u017c\u012bna \u0101man\u1ee5 wa k\u0101n\u1ee5 yattaq\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041018.mp3","juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"verseId":19,"ayahText":"\u0648\u064e\u064a\u064e\u0648\u0652\u0645\u064e \u064a\u064f\u062d\u0652\u0634\u064e\u0631\u064f \u0627\u064e\u0639\u0652\u062f\u064e\u0627\u06e4\u0621\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0650\u0644\u064e\u0649 \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0641\u064e\u0647\u064f\u0645\u0652 \u064a\u064f\u0648\u0652\u0632\u064e\u0639\u064f\u0648\u0652\u0646\u064e","indoText":"Dan (ingatlah) pada hari (ketika) musuh-musuh Allah digiring ke neraka lalu mereka dipisah-pisahkan.","enText":"And [mention, O Muhammad], the Day when the enemies of Allah will be gathered to the Fire while they are [driven] assembled in rows,","readText":"wa yauma yu\u1e25syaru a'd\u0101`ull\u0101hi ilan-n\u0101ri fa hum y\u1ee5za'\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/041019.mp3","juz":24,"manzil":6,"page":478,"ruku":415,"hizbQuarter":191,"sajda":false},{"verseId":20,"ayahText":"\u062d\