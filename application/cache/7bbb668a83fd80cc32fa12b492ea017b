62a\u064f\u0645\u0652 \u062e\u064e\u0634\u0652\u064a\u064e\u0629\u064e \u0627\u0644\u0652\u0627\u0650\u0646\u0652\u0641\u064e\u0627\u0642\u0650\u06d7 \u0648\u064e\u0643\u064e\u0627\u0646\u064e \u0627\u0644\u0652\u0627\u0650\u0646\u0652\u0633\u064e\u0627\u0646\u064f \u0642\u064e\u062a\u064f\u0648\u0652\u0631\u064b\u0627","indoText":"Katakanlah (Muhammad), \u201cSekiranya kamu menguasai perbendaharaan rahmat Tuhanku, niscaya (perbendaharaan) itu kamu tahan, karena takut membelanjakannya.\u201d Dan manusia itu memang sangat kikir.","enText":"Say [to them], \"If you possessed the depositories of the mercy of my Lord, then you would withhold out of fear of spending.\" And ever has man been stingy.","readText":"qul lau antum tamlik\u1ee5na khaz\u0101`ina ra\u1e25mati rabb\u012b i\u017cal la`amsaktum khasy-yatal-inf\u0101q, wa k\u0101nal-ins\u0101nu qat\u1ee5r\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017100.mp3","juz":15,"manzil":4,"page":292,"ruku":250,"hizbQuarter":117,"sajda":false},{"verseId":101,"ayahText":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u0652 \u0627\u0670\u062a\u064e\u064a\u0652\u0646\u064e\u0627 \u0645\u064f\u0648\u0652\u0633\u0670\u0649 \u062a\u0650\u0633\u0652\u0639\u064e \u0627\u0670\u064a\u0670\u062a\u064d\u06e2 \u0628\u064e\u064a\u0651\u0650\u0646\u0670\u062a\u064d \u0641\u064e\u0633\u0652\u0640\u0654\u064e\u0644\u0652 \u0628\u064e\u0646\u0650\u064a\u0653\u0652 \u0627\u0650\u0633\u0652\u0631\u064e\u0627\u06e4\u0621\u0650\u064a\u0652\u0644\u064e \u0627\u0650\u0630\u0652 \u062c\u064e\u0627\u06e4\u0621\u064e\u0647\u064f\u0645\u0652 \u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0644\u064e\u0647\u0657 \u0641\u0650\u0631\u0652\u0639\u064e\u0648\u0652\u0646\u064f \u0627\u0650\u0646\u0651\u0650\u064a\u0652 \u0644\u064e\u0627\u064e\u0638\u064f\u0646\u0651\u064f\u0643\u064e \u064a\u0670\u0645\u064f\u0648\u0652\u0633\u0670\u0649 \u0645\u064e\u0633\u0652\u062d\u064f\u0648\u0652\u0631\u064b\u0627","indoText":"Dan sungguh, Kami telah memberikan kepada Musa sembilan mukjizat yang nyata maka tanyakanlah kepada Bani Israil, ketika Musa datang kepada mereka lalu Fir\u2018aun berkata kepadanya, \u201cWahai Musa! Sesungguhnya aku benar-benar menduga engkau terkena sihir.\u201d","enText":"And We had certainly given Moses nine evident signs, so ask the Children of Israel [about] when he came to them and Pharaoh said to him, \"Indeed I think, O Moses, that you are affected by magic.\"","readText":"wa laqad \u0101tain\u0101 m\u1ee5s\u0101 tis'a \u0101y\u0101tim bayyin\u0101tin fas`al ban\u012b isr\u0101`\u012bla i\u017c j\u0101`ahum fa q\u0101la lah\u1ee5 fir'aunu inn\u012b la`a\u1e93unnuka y\u0101 m\u1ee5s\u0101 mas-\u1e25\u1ee5r\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017101.mp3","juz":15,"manzil":4,"page":292,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":102,"ayahText":"\u0642\u064e\u0627\u0644\u064e \u0644\u064e\u0642\u064e\u062f\u0652 \u0639\u064e\u0644\u0650\u0645\u0652\u062a\u064e \u0645\u064e\u0627\u0653 \u0627\u064e\u0646\u0652\u0632\u064e\u0644\u064e \u0647\u0653\u0670\u0624\u064f\u0644\u064e\u0627\u06e4\u0621\u0650 \u0627\u0650\u0644\u0651\u064e\u0627 \u0631\u064e\u0628\u0651\u064f \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0628\u064e\u0635\u064e\u0627\u06e4\u0649\u0655\u0650\u0631\u064e\u06da \u0648\u064e\u0627\u0650\u0646\u0651\u0650\u064a\u0652 \u0644\u064e\u0627\u064e\u0638\u064f\u0646\u0651\u064f\u0643\u064e \u064a\u0670\u0641\u0650\u0631\u0652\u0639\u064e\u0648\u0652\u0646\u064f \u0645\u064e\u062b\u0652\u0628\u064f\u0648\u0652\u0631\u064b\u0627","indoText":"Dia (Musa) menjawab, \u201dSungguh, engkau telah mengetahui, bahwa tidak ada yang menurunkan (mukjizat-mukjizat) itu kecuali Tuhan (yang memelihara) langit dan bumi sebagai bukti-bukti yang nyata; dan sungguh, aku benar-benar menduga engkau akan binasa, wahai Fir\u2018aun.\u201d","enText":"[Moses] said, \"You have already known that none has sent down these [signs] except the Lord of the heavens and the earth as evidence, and indeed I think, O Pharaoh, that you are destroyed.\"","readText":"q\u0101la laqad 'alimta m\u0101 anzala h\u0101`ul\u0101`i ill\u0101 rabbus-sam\u0101w\u0101ti wal-ar\u1e0di ba\u1e63\u0101`ir, wa inn\u012b la`a\u1e93unnuka y\u0101 fir'aunu ma\u1e61b\u1ee5r\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017102.mp3","juz":15,"manzil":4,"page":292,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":103,"ayahText":"\u0641\u064e\u0627\u064e\u0631\u064e\u0627\u062f\u064e \u0627\u064e\u0646\u0652 \u064a\u0651\u064e\u0633\u0652\u062a\u064e\u0641\u0650\u0632\u0651\u064e\u0647\u064f\u0645\u0652 \u0645\u0651\u0650\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0641\u064e\u0627\u064e\u063a\u0652\u0631\u064e\u0642\u0652\u0646\u0670\u0647\u064f \u0648\u064e\u0645\u064e\u0646\u0652 \u0645\u0651\u064e\u0639\u064e\u0647\u0657 \u062c\u064e\u0645\u0650\u064a\u0652\u0639\u064b\u0627\u06d9","indoText":"Kemudian dia (Fir\u2018aun) hendak mengusir mereka (Musa dan pengikutnya) dari bumi (Mesir), maka Kami tenggelamkan dia (Fir\u2018aun) beserta orang yang bersama dia seluruhnya.","enText":"So he intended to drive them from the land, but We drowned him and those with him all together.","readText":"fa ar\u0101da ay yastafizzahum minal-ar\u1e0di fa agraqn\u0101hu wa mam ma'ah\u1ee5 jam\u012b'\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017103.mp3","juz":15,"manzil":4,"page":292,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":104,"ayahText":"\u0648\u0651\u064e\u0642\u064f\u0644\u0652\u0646\u064e\u0627 \u0645\u0650\u0646\u0652\u06e2 \u0628\u064e\u0639\u0652\u062f\u0650\u0647\u0656 \u0644\u0650\u0628\u064e\u0646\u0650\u064a\u0653\u0652 \u0627\u0650\u0633\u0652\u0631\u064e\u0627\u06e4\u0621\u0650\u064a\u0652\u0644\u064e \u0627\u0633\u0652\u0643\u064f\u0646\u064f\u0648\u0627 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0641\u064e\u0627\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u06e4\u0621\u064e \u0648\u064e\u0639\u0652\u062f\u064f \u0627\u0644\u0652\u0627\u0670\u062e\u0650\u0631\u064e\u0629\u0650 \u062c\u0650\u0626\u0652\u0646\u064e\u0627 \u0628\u0650\u0643\u064f\u0645\u0652 \u0644\u064e\u0641\u0650\u064a\u0652\u0641\u064b\u0627\u06d7","indoText":"Dan setelah itu Kami berfirman kepada Bani Israil, \u201cTinggallah di negeri ini, tetapi apabila masa berbangkit datang, niscaya Kami kumpulkan kamu dalam keadaan bercampur baur.\u201d","enText":"And We said after Pharaoh to the Children of Israel, \"Dwell in the land, and when there comes the promise of the Hereafter, We will bring you forth in [one] gathering.\"","readText":"wa quln\u0101 mim ba'dih\u012b liban\u012b isr\u0101`\u012blaskunul-ar\u1e0da fa i\u017c\u0101 j\u0101`a wa'dul-\u0101khirati ji`n\u0101 bikum laf\u012bf\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017104.mp3","juz":15,"manzil":4,"page":292,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":105,"ayahText":"\u0648\u064e\u0628\u0650\u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0627\u064e\u0646\u0652\u0632\u064e\u0644\u0652\u0646\u0670\u0647\u064f \u0648\u064e\u0628\u0650\u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0646\u064e\u0632\u064e\u0644\u064e\u06d7 \u0648\u064e\u0645\u064e\u0627\u0653 \u0627\u064e\u0631\u0652\u0633\u064e\u0644\u0652\u0646\u0670\u0643\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0645\u064f\u0628\u064e\u0634\u0651\u0650\u0631\u064b\u0627 \u0648\u0651\u064e\u0646\u064e\u0630\u0650\u064a\u0652\u0631\u064b\u0627\u06d8","indoText":"Dan Kami turunkan (Al-Qur'an) itu dengan sebenarnya dan (Al-Qur'an) itu turun dengan (membawa) kebenaran. Dan Kami mengutus engkau (Muhammad), hanya sebagai pembawa berita gembira dan pemberi peringatan.","enText":"And with the truth We have sent the Qur'an down, and with the truth it has descended. And We have not sent you, [O Muhammad], except as a bringer of good tidings and a warner.","readText":"wa bil-\u1e25aqqi anzaln\u0101hu wa bil-\u1e25aqqi nazal, wa m\u0101 arsaln\u0101ka ill\u0101 mubasysyiraw wa na\u017c\u012br\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017105.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":106,"ayahText":"\u0648\u064e\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u064b\u0627 \u0641\u064e\u0631\u064e\u0642\u0652\u0646\u0670\u0647\u064f \u0644\u0650\u062a\u064e\u0642\u0652\u0631\u064e\u0627\u064e\u0647\u0657 \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u0639\u064e\u0644\u0670\u0649 \u0645\u064f\u0643\u0652\u062b\u064d \u0648\u0651\u064e\u0646\u064e\u0632\u0651\u064e\u0644\u0652\u0646\u0670\u0647\u064f \u062a\u064e\u0646\u0652\u0632\u0650\u064a\u0652\u0644\u064b\u0627","indoText":"Dan Al-Qur'an (Kami turunkan) berangsur-angsur agar engkau (Muhammad) membacakannya kepada manusia perlahan-lahan dan Kami menurunkannya secara bertahap.","enText":"And [it is] a Qur'an which We have separated [by intervals] that you might recite it to the people over a prolonged period. And We have sent it down progressively.","readText":"wa qur`\u0101nan faraqn\u0101hu litaqra`ah\u1ee5 'alan-n\u0101si 'al\u0101 muk\u1e61iw wa nazzaln\u0101hu tanz\u012bl\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017106.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":107,"ayahText":"\u0642\u064f\u0644\u0652 \u0627\u0670\u0645\u0650\u0646\u064f\u0648\u0652\u0627 \u0628\u0650\u0647\u0656\u0653 \u0627\u064e\u0648\u0652 \u0644\u064e\u0627 \u062a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0652\u0627\u06d7 \u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0627\u064f\u0648\u0652\u062a\u064f\u0648\u0627 \u0627\u0644\u0652\u0639\u0650\u0644\u0652\u0645\u064e \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650\u0647\u0656\u0653 \u0627\u0650\u0630\u064e\u0627 \u064a\u064f\u062a\u0652\u0644\u0670\u0649 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u064a\u064e\u062e\u0650\u0631\u0651\u064f\u0648\u0652\u0646\u064e \u0644\u0650\u0644\u0652\u0627\u064e\u0630\u0652\u0642\u064e\u0627\u0646\u0650 \u0633\u064f\u062c\u0651\u064e\u062f\u064b\u0627\u06d9","indoText":"Katakanlah (Muhammad), \u201cBerimanlah kamu kepadanya (Al-Qur'an) atau tidak usah beriman (sama saja bagi Allah). Sesungguhnya orang yang telah diberi pengetahuan sebelumnya, apabila (Al-Qur'an) dibacakan kepada mereka, mereka menyungkurkan wajah, bersujud,\u201d","enText":"Say, \"Believe in it or do not believe. Indeed, those who were given knowledge before it - when it is recited to them, they fall upon their faces in prostration,","readText":"qul \u0101min\u1ee5 bih\u012b au l\u0101 tu`min\u1ee5, innalla\u017c\u012bna \u1ee5tul-'ilma ming qablih\u012b i\u017c\u0101 yutl\u0101 'alaihim yakhirr\u1ee5na lil-a\u017cq\u0101ni sujjad\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017107.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":108,"ayahText":"\u0648\u0651\u064e\u064a\u064e\u0642\u064f\u0648\u0652\u0644\u064f\u0648\u0652\u0646\u064e \u0633\u064f\u0628\u0652\u062d\u0670\u0646\u064e \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627\u0653 \u0627\u0650\u0646\u0652 \u0643\u064e\u0627\u0646\u064e \u0648\u064e\u0639\u0652\u062f\u064f \u0631\u064e\u0628\u0651\u0650\u0646\u064e\u0627 \u0644\u064e\u0645\u064e\u0641\u0652\u0639\u064f\u0648\u0652\u0644\u064b\u0627","indoText":"dan mereka berkata, \u201cMahasuci Tuhan kami; sungguh, janji Tuhan kami pasti dipenuhi.\u201d","enText":"And they say, \"Exalted is our Lord! Indeed, the promise of our Lord has been fulfilled.\"","readText":"wa yaq\u1ee5l\u1ee5na sub-\u1e25\u0101na rabbin\u0101 ing k\u0101na wa'du rabbin\u0101 lamaf'\u1ee5l\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017108.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":109,"ayahText":"\u0648\u064e\u064a\u064e\u062e\u0650\u0631\u0651\u064f\u0648\u0652\u0646\u064e \u0644\u0650\u0644\u0652\u0627\u064e\u0630\u0652\u0642\u064e\u0627\u0646\u0650 \u064a\u064e\u0628\u0652\u0643\u064f\u0648\u0652\u0646\u064e \u0648\u064e\u064a\u064e\u0632\u0650\u064a\u0652\u062f\u064f\u0647\u064f\u0645\u0652 \u062e\u064f\u0634\u064f\u0648\u0652\u0639\u064b\u0627 \u06e9","indoText":"Dan mereka menyungkurkan wajah sambil menangis dan mereka bertambah khusyuk.","enText":"And they fall upon their faces weeping, and the Qur'an increases them in humble submission.","readText":"wa yakhirr\u1ee5na lil-a\u017cq\u0101ni yabk\u1ee5na wa yaz\u012bduhum khusy\u1ee5'\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017109.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":true},{"verseId":110,"ayahText":"\u0642\u064f\u0644\u0650 \u0627\u062f\u0652\u0639\u064f\u0648\u0627 \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0627\u064e\u0648\u0650 \u0627\u062f\u0652\u0639\u064f\u0648\u0627 \u0627\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u0670\u0646\u064e\u06d7 \u0627\u064e\u064a\u0651\u064b\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u062f\u0652\u0639\u064f\u0648\u0652\u0627 \u0641\u064e\u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0627\u064e\u0633\u0652\u0645\u064e\u0627\u06e4\u0621\u064f \u0627\u0644\u0652\u062d\u064f\u0633\u0652\u0646\u0670\u0649\u06da \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062c\u0652\u0647\u064e\u0631\u0652 \u0628\u0650\u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0643\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064f\u062e\u064e\u0627\u0641\u0650\u062a\u0652 \u0628\u0650\u0647\u064e\u0627 \u0648\u064e\u0627\u0628\u0652\u062a\u064e\u063a\u0650 \u0628\u064e\u064a\u0652\u0646\u064e \u0630\u0670\u0644\u0650\u0643\u064e \u0633\u064e\u0628\u0650\u064a\u0652\u0644\u064b\u0627","indoText":"Katakanlah (Muhammad), \u201cSerulah Allah atau serulah Ar-Rahman. Dengan nama yang mana saja kamu dapat menyeru, karena Dia mempunyai nama-nama yang terbaik (Asma\u2018ul husna) dan janganlah engkau mengeraskan suaramu dalam salat dan janganlah (pula) merendahkannya dan usahakan jalan tengah di antara kedua itu.\u201d","enText":"Say, \"Call upon Allah or call upon the Most Merciful. Whichever [name] you call - to Him belong the best names.\" And do not recite [too] loudly in your prayer or [too] quietly but seek between that an [intermediate] way.","readText":"qulid'ull\u0101ha awid'ur-ra\u1e25m\u0101n, ayyam m\u0101 tad'\u1ee5 fa lahul-asm\u0101`ul-\u1e25usn\u0101, wa l\u0101 taj-har bi\u1e63al\u0101tika wa l\u0101 tukh\u0101fit bih\u0101 wabtagi baina \u017c\u0101lika sab\u012bl\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017110.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":false},{"verseId":111,"ayahText":"\u0648\u064e\u0642\u064f\u0644\u0650 \u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u0670\u0647\u0650 \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u0644\u064e\u0645\u0652 \u064a\u064e\u062a\u0651\u064e\u062e\u0650\u0630\u0652 \u0648\u064e\u0644\u064e\u062f\u064b\u0627 \u0648\u0651\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u0651\u064e\u0647\u0657 \u0634\u064e\u0631\u0650\u064a\u0652\u0643\u064c \u0641\u0650\u0649 \u0627\u0644\u0652\u0645\u064f\u0644\u0652\u0643\u0650 \u0648\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u0643\u064f\u0646\u0652 \u0644\u0651\u064e\u0647\u0657 \u0648\u064e\u0644\u0650\u064a\u0651\u064c \u0645\u0651\u0650\u0646\u064e \u0627\u0644\u0630\u0651\u064f\u0644\u0651\u0650 \u0648\u064e\u0643\u064e\u0628\u0651\u0650\u0631\u0652\u0647\u064f \u062a\u064e\u0643\u0652\u0628\u0650\u064a\u0652\u0631\u064b\u0627","indoText":"Dan katakanlah, \u201cSegala puji bagi Allah yang tidak mempunyai anak dan tidak (pula) mempunyai sekutu dalam kerajaan-Nya dan Dia tidak memerlukan penolong dari kehinaan dan agungkanlah Dia seagung-agungnya.","enText":"And say, \"Praise to Allah, who has not taken a son and has had no partner in [His] dominion and has no [need of a] protector out of weakness; and glorify Him with [great] glorification.\"","readText":"wa qulil-\u1e25amdu lill\u0101hilla\u017c\u012b lam yattakhi\u017c waladaw wa lam yakul lah\u1ee5 syar\u012bkun fil-mulki wa lam yakul lah\u1ee5 waliyyum mina\u017c-\u017culli wa kabbir-hu takb\u012br\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/017111.mp3","juz":15,"manzil":4,"page":293,"ruku":251,"hizbQuarter":117,"sajda":false}]}";}