,"ruku":391,"hizbQuarter":181,"sajda":false},{"verseId":9,"ayahText":"\u0627\u064e\u0645\u0652 \u0639\u0650\u0646\u0652\u062f\u064e\u0647\u064f\u0645\u0652 \u062e\u064e\u0632\u064e\u0627\u06e4\u0649\u0655\u0650\u0646\u064f \u0631\u064e\u062d\u0652\u0645\u064e\u0629\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0627\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0652\u0632\u0650 \u0627\u0644\u0652\u0648\u064e\u0647\u0651\u064e\u0627\u0628\u0650\u06da","indoText":"Atau apakah mereka itu mempunyai perbendaharaan rahmat Tuhanmu Yang Mahaperkasa, Maha Pemberi?]","enText":"Or do they have the depositories of the mercy of your Lord, the Exalted in Might, the Bestower?","readText":"am 'indahum khaz\u0101`inu ra\u1e25mati rabbikal-'az\u012bzil wahh\u0101b","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/038009.mp3","juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"verseId":10,"ayahText":"\u0627\u064e\u0645\u0652 \u0644\u064e\u0647\u064f\u0645\u0652 \u0645\u0651\u064f\u0644\u0652\u0643\u064f \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u06d7\u0641\u064e\u0644\u0652\u064a\u064e\u0631\u0652\u062a\u064e\u0642\u064f\u0648\u0652\u0627 \u0641\u0650\u0649 \u0627\u0644\u0652\u0627\u064e\u0633\u0652\u0628\u064e\u0627\u0628\u0650","indoText":"Atau apakah mereka mempunyai kerajaan langit dan bumi dan apa yang ada di antara keduanya? (Jika ada), maka biarlah mereka menaiki tangga-tangga (ke langit).","enText":"Or is theirs the dominion of the heavens and the earth and what is between them? Then let them ascend through [any] ways of access.","readText":"am lahum mulkus-sam\u0101w\u0101ti wal-ar\u1e0di wa m\u0101 bainahum\u0101, falyartaq\u1ee5 fil-asb\u0101b","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/038010.mp3","juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"verseId":11,"ayahText":"\u062c\u064f\u0646\u0652\u062f\u064c \u0645\u0651\u064e\u0627 \u0647\u064f\u0646\u064e\u0627\u0644\u0650\u0643\u064e \u0645\u064e\u0647\u0652\u0632\u064f\u0648\u0652\u0645\u064c \u0645\u0650\u0651\u0646\u064e \u0627\u0644\u0652\u0627\u064e\u062d\u0652\u0632\u064e\u0627\u0628\u0650","indoText":"(Mereka itu) kelompok besar bala tentara yang berada di sana yang akan dikalahkan.","enText":"[They are but] soldiers [who will be] defeated there among the companies [of disbelievers].","readText":"jundum m\u0101 hun\u0101lika mahz\u1ee5mum minal-a\u1e25z\u0101b","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/038011.mp3","juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"verseId":12,"ayahText":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u0652 \u0642\u064e\u0628\u0652\u0644\u064e\u0647\u064f\u0645\u0652 \u0642\u064e\u0648\u0652\u0645\u064f \u0646\u064f\u0648\u0652\u062d\u064d \u0648\u0651\u064e\u0639\u064e\u0627\u062f\u064c \u0648\u0651\u064e\u0641\u0650\u0631\u0652\u0639\u064e\u0648\u0652\u0646\u064f \u0630\u064f\u0648 \u0627\u0644\u0652\u0627\u064e\u0648\u0652\u062a\u064e\u0627\u062f\u0650\u06d9","indoText":"Sebelum mereka itu, kaum Nuh, \u2018Ad dan Fir\u2019aun yang mempunyai bala tentara yang banyak, juga telah mendustakan (rasul-rasul),","enText":"The people of Noah denied before them, and [the tribe of] 'Aad and Pharaoh, the owner of stakes,","readText":"ka\u017c\u017cabat qablahum qaumu n\u1ee5\u1e25iw wa '\u0101duw wa fir'aunu \u017cul-aut\u0101d","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/038012.mp3","juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"verseId":13,"ayahText":"\u0648\u064e\u062b\u064e\u0645\u064f\u0648\u0652\u062f\u064f \u0648\u064e\u0642\u064e\u0648\u0652\u0645\u064f \u0644\u064f\u0648\u0652\u0637\u064d \u0648\u0651\u064e\u0627\u064e\u0635\u0652\u062d\u0670\u0628\u064f \u0644\u0652\u0640\u0654\u064e\u064a\u0652\u0643