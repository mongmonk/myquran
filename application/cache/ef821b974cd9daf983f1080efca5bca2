33\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u064e\u0627\u06d8 \u0627\u0650\u0646\u0652 \u0643\u064f\u0646\u0652\u062a\u064f\u0645\u0652 \u0645\u0651\u064f\u0648\u0652\u0642\u0650\u0646\u0650\u064a\u0652\u0646\u064e","indoText":"Tuhan (yang memelihara) langit dan bumi dan apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini.","enText":"Lord of the heavens and the earth and that between them, if you would be certain.","readText":"rabbis-sam\u0101w\u0101ti wal-ar\u1e0di wa m\u0101 bainahum\u0101, ing kuntum m\u1ee5qin\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044007.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":8,"ayahText":"\u0644\u064e\u0627\u0653 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e \u064a\u064f\u062d\u0652\u064a\u0656 \u0648\u064e\u064a\u064f\u0645\u0650\u064a\u0652\u062a\u064f \u06d7\u0631\u064e\u0628\u0651\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0631\u064e\u0628\u0651\u064f \u0627\u0670\u0628\u064e\u0627\u06e4\u0649\u0655\u0650\u0643\u064f\u0645\u064f \u0627\u0644\u0652\u0627\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0652\u0646\u064e","indoText":"Tidak ada tuhan selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu.","enText":"There is no deity except Him; He gives life and causes death. [He is] your Lord and the Lord of your first forefathers.","readText":"l\u0101 il\u0101ha ill\u0101 huwa yu\u1e25y\u012b wa yum\u012bt, rabbukum wa rabbu \u0101b\u0101`ikumul-awwal\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044008.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":9,"ayahText":"\u0628\u064e\u0644\u0652 \u0647\u064f\u0645\u0652 \u0641\u0650\u064a\u0652 \u0634\u064e\u0643\u0651\u064d \u064a\u0651\u064e\u0644\u0652\u0639\u064e\u0628\u064f\u0648\u0652\u0646\u064e","indoText":"Tetapi mereka dalam keraguan, mereka bermain-main.","enText":"But they are in doubt, amusing themselves.","readText":"bal hum f\u012b syakkiy yal'ab\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044009.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":10,"ayahText":"\u0641\u064e\u0627\u0631\u0652\u062a\u064e\u0642\u0650\u0628\u0652 \u064a\u064e\u0648\u0652\u0645\u064e \u062a\u064e\u0623\u0652\u062a\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u06e4\u0621\u064f \u0628\u0650\u062f\u064f\u062e\u064e\u0627\u0646\u064d \u0645\u0651\u064f\u0628\u0650\u064a\u0652\u0646\u064d","indoText":"Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,","enText":"Then watch for the Day when the sky will bring a visible smoke.","readText":"fartaqib yauma ta`tis-sam\u0101`u bidukh\u0101nim mub\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044010.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":11,"ayahText":"\u064a\u064e\u063a\u0652\u0634\u064e\u0649 \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e\u06d7 \u0647\u0670\u0630\u064e\u0627 \u0639\u064e\u0630\u064e\u0627\u0628\u064c \u0627\u064e\u0644\u0650\u064a\u0652\u0645\u064c","indoText":"yang meliputi manusia. Inilah azab yang pedih.","enText":"Covering the people; this is a painful torment.","readText":"yagsyan-n\u0101s, h\u0101\u017c\u0101 'a\u017c\u0101bun al\u012bm","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044011.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":12,"ayahText":"\u0631\u064e\u0628\u0651\u064e\u0646\u064e\u0627 \u0627\u0643\u0652\u0634\u0650\u0641\u0652 \u0639\u064e\u0646\u0651\u064e\u0627 \u0627\u0644\u0652\u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0627\u0650\u0646\u0651\u064e\u0627 \u0645\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0652\u0646\u064e","indoText":"(Mereka berdoa), \u201cYa Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\u201d","enText":"[They will say], \"Our Lord, remove from us the torment; indeed, we are believers.\"","readText":"rabbanaksyif 'annal-'a\u017c\u0101ba inn\u0101 mu`min\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044012.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":13,"ayahText":"\u0627\u064e\u0646\u0651\u0670\u0649 \u0644\u064e\u0647\u064f\u0645\u064f \u0627\u0644\u0630\u0651\u0650\u0643\u0652\u0631\u0670\u0649 \u0648\u064e\u0642\u064e\u062f\u0652 \u062c\u064e\u0627\u06e4\u0621\u064e\u0647\u064f\u0645\u0652 \u0631\u064e\u0633\u064f\u0648\u0652\u0644\u064c \u0645\u0651\u064f\u0628\u0650\u064a\u0652\u0646\u064c\u06d9","indoText":"Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,","enText":"How will there be for them a reminder [at that time]? And there had come to them a clear Messenger.","readText":"ann\u0101 lahumu\u017c-\u017cikr\u0101 wa qad j\u0101`ahum ras\u1ee5lum mub\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044013.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":14,"ayahText":"\u062b\u064f\u0645\u0651\u064e \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0648\u0652\u0627 \u0639\u064e\u0646\u0652\u0647\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0652\u0627 \u0645\u064f\u0639\u064e\u0644\u0651\u064e\u0645\u064c \u0645\u0651\u064e\u062c\u0652\u0646\u064f\u0648\u0652\u0646\u064c\u06d8","indoText":"kemudian mereka berpaling darinya dan berkata, \u201cDia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\u201d","enText":"Then they turned away from him and said, \"[He was] taught [and is] a madman.\"","readText":"\u1e61umma tawallau 'an-hu wa q\u0101l\u1ee5 mu'allamum majn\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044014.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":15,"ayahText":"\u0627\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0627\u0634\u0650\u0641\u064f\u0648\u0627 \u0627\u0644\u0652\u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0642\u064e\u0644\u0650\u064a\u0652\u0644\u064b\u0627 \u0627\u0650\u0646\u0651\u064e\u0643\u064f\u0645\u0652 \u0639\u064e\u0627\u06e4\u0649\u0655\u0650\u062f\u064f\u0648\u0652\u0646\u064e\u06d8","indoText":"Sungguh (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar).","enText":"Indeed, We will remove the torment for a little. Indeed, you [disbelievers] will return [to disbelief].","readText":"inn\u0101 k\u0101syiful-'a\u017c\u0101bi qal\u012blan innakum '\u0101`id\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044015.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":16,"ayahText":"\u064a\u064e\u0648\u0652\u0645\u064e \u0646\u064e\u0628\u0652\u0637\u0650\u0634\u064f \u0627\u0644\u0652\u0628\u064e\u0637\u0652\u0634\u064e\u0629\u064e \u0627\u0644\u0652\u0643\u064f\u0628\u0652\u0631\u0670\u0649\u06da \u0627\u0650\u0646\u0651\u064e\u0627 \u0645\u064f\u0646\u0652\u062a\u064e\u0642\u0650\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras. Kami pasti memberi balasan.","enText":"The Day We will strike with the greatest assault, indeed, We will take retribution.","readText":"yauma nab\u1e6disyul-ba\u1e6dsyatal-kubr\u0101, inn\u0101 muntaqim\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/044016.mp3","juz":25,"manzil":6,"page":496,"ruku":431,"hizbQuarter":198,"sajda":false},{"verseId":17,"ayahText":"\u06de \u0648\u064e\u0644\u064e\u0642\u064e\u062f\u0652 \u0641\u064e\u062a\u064e\u0646\u0651\u064e\u0627 \u0642\u064e\u0628\u0652\u0644\u064e\u0647\u064f\u0645\u0652 \u0642\u064e\u0648\