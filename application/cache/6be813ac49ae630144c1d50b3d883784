a:3:{s:4:"time";i:1674133860;s:3:"ttl";i:31536000;s:4:"data";s:143185:"{"translationId":"TaHa","translationEn":"Taa-Haa","asma":"\u0637\u0647","numberOfAyahs":135,"name":"Thaahaa","number":20,"typeId":"mekah","typeEn":"Meccan","orderNumber":45,"ayahs":[{"verseId":1,"ayahText":"\u0637\u0670\u0647\u0670 \u06da","indoText":"Thaha","enText":"Ta, Ha.","readText":"\u1e6d\u0101 h\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020001.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":2,"ayahText":"\u0645\u064e\u0627\u0653 \u0627\u064e\u0646\u0652\u0632\u064e\u0644\u0652\u0646\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u064e \u0644\u0650\u062a\u064e\u0634\u0652\u0642\u0670\u0653\u0649 \u06d9","indoText":" Kami tidak menurunkan Al-Qur'an ini kepadamu (Muhammad) agar engkau menjadi susah;","enText":"We have not sent down to you the Qur'an that you be distressed","readText":"m\u0101 anzaln\u0101 'alaikal-qur`\u0101na litasyq\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020002.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":3,"ayahText":"\u0627\u0650\u0644\u0651\u064e\u0627 \u062a\u064e\u0630\u0652\u0643\u0650\u0631\u064e\u0629\u064b \u0644\u0650\u0651\u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u062e\u0652\u0634\u0670\u0649 \u06d9","indoText":" melainkan sebagai peringatan bagi orang yang takut (kepada Allah),","enText":"But only as a reminder for those who fear [Allah] -","readText":"ill\u0101 ta\u017ckiratal limay yakhsy\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020003.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":4,"ayahText":"\u062a\u064e\u0646\u0652\u0632\u0650\u064a\u0652\u0644\u064b\u0627 \u0645\u0650\u0651\u0645\u0651\u064e\u0646\u0652 \u062e\u064e\u0644\u064e\u0642\u064e \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u064e \u0648\u064e\u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0627\u0644\u0652\u0639\u064f\u0644\u0670\u0649 \u06d7","indoText":"diturunkan dari (Allah) yang menciptakan bumi dan langit yang tinggi,","enText":"A revelation from He who created the earth and highest heavens,","readText":"tanz\u012blam mim man khalaqal-ar\u1e0da was-sam\u0101w\u0101til-'ul\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020004.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":5,"ayahText":"\u0627\u064e\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u0670\u0646\u064f \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0652\u0639\u064e\u0631\u0652\u0634\u0650 \u0627\u0633\u0652\u062a\u064e\u0648\u0670\u0649","indoText":"(yaitu) Yang Maha Pengasih, yang bersemayam di atas \u2018Arsy.","enText":"The Most Merciful [who is] above the Throne established.","readText":"ar-ra\u1e25m\u0101nu 'alal-'arsyistaw\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020005.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":6,"ayahText":"\u0644\u064e\u0647\u0657 \u0645\u064e\u0627 \u0641\u0650\u0649 \u0627\u0644\u0633\u0651\u064e\u0645\u0670\u0648\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u0649 \u0627\u0644\u0652\u0627\u064e\u0631\u0652\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u062d\u0652\u062a\u064e \u0627\u0644\u062b\u0651\u064e\u0631\u0670\u0649","indoText":"Milik-Nyalah apa yang ada di langit, apa yang ada di bumi, apa yang ada di antara keduanya, dan apa yang ada di bawah tanah.","enText":"To Him belongs what is in the heavens and what is on the earth and what is between them and what is under the soil.","readText":"lah\u1ee5 m\u0101 fis-sam\u0101w\u0101ti wa m\u0101 fil-ar\u1e0di wa m\u0101 bainahum\u0101 wa m\u0101 ta\u1e25ta\u1e61-\u1e61ar\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020006.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":7,"ayahText":"\u0648\u064e\u0627\u0650\u0646\u0652 \u062a\u064e\u062c\u0652\u0647\u064e\u0631\u0652 \u0628\u0650\u0627\u0644\u0652\u0642\u064e\u0648\u0652\u0644\u0650 \u0641\u064e\u0627\u0650\u0646\u0651\u064e\u0647\u0657 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0627\u0644\u0633\u0651\u0650\u0631\u0651\u064e \u0648\u064e\u0627\u064e\u062e\u0652\u0641\u0670\u0649","indoText":"Dan jika engkau mengeraskan ucapanmu, sungguh, Dia mengetahui rahasia dan yang lebih tersembunyi.","enText":"And if you speak aloud - then indeed, He knows the secret and what is [even] more hidden.","readText":"wa in taj-har bil-qauli fa innah\u1ee5 ya'lamus-sirra wa akhf\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020007.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":8,"ayahText":"\u0627\u064e\u0644\u0644\u0651\u0670\u0647\u064f \u0644\u064e\u0627\u0653 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06d7 \u0644\u064e\u0647\u064f \u0627\u0644\u0652\u0627\u064e\u0633\u0652\u0645\u064e\u0627\u06e4\u0621\u064f \u0627\u0644\u0652\u062d\u064f\u0633\u0652\u0646\u0670\u0649","indoText":"(Dialah) Allah, tidak ada tuhan selain Dia, yang mempunyai nama-nama yang terbaik.","enText":"Allah - there is no deity except Him. To Him belong the best names.","readText":"all\u0101hu l\u0101 il\u0101ha ill\u0101 huw, lahul-asm\u0101`ul-\u1e25usn\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020008.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":9,"ayahText":"\u0648\u064e\u0647\u064e\u0644\u0652 \u0627\u064e\u062a\u0670\u0649\u0643\u064e \u062d\u064e\u062f\u0650\u064a\u0652\u062b\u064f \u0645\u064f\u0648\u0652\u0633\u0670\u0649 \u06d8","indoText":" Dan apakah telah sampai kepadamu kisah Musa?","enText":"And has the story of Moses reached you? -","readText":"wa hal at\u0101ka \u1e25ad\u012b\u1e61u m\u1ee5s\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020009.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":10,"ayahText":"\u0627\u0650\u0630\u0652 \u0631\u064e\u0627\u0670 \u0646\u064e\u0627\u0631\u064b\u0627 \u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0644\u0650\u0627\u064e\u0647\u0652\u0644\u0650\u0647\u0650 \u0627\u0645\u0652\u0643\u064f\u062b\u064f\u0648\u0652\u0653\u0627 \u0627\u0650\u0646\u0651\u0650\u064a\u0652 \u0627\u0670\u0646\u064e\u0633\u0652\u062a\u064f \u0646\u064e\u0627\u0631\u064b\u0627 \u0644\u0651\u064e\u0639\u064e\u0644\u0651\u0650\u064a\u0652\u0653 \u0627\u0670\u062a\u0650\u064a\u0652\u0643\u064f\u0645\u0652 \u0645\u0651\u0650\u0646\u0652\u0647\u064e\u0627 \u0628\u0650\u0642\u064e\u0628\u064e\u0633\u064d \u0627\u064e\u0648\u0652 \u0627\u064e\u062c\u0650\u062f\u064f \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0647\u064f\u062f\u064b\u0649","indoText":" Ketika dia (Musa) melihat api, lalu dia berkata kepada keluarganya, \u201cTinggallah kamu (di sini), sesungguhnya aku melihat api, mudah-mudahan aku dapat membawa sedikit nyala api kepadamu atau aku akan mendapat petunjuk di tempat api itu.\u201d","enText":"When he saw a fire and said to his family, \"Stay here; indeed, I have perceived a fire; perhaps I can bring you a torch or find at the fire some guidance.\"","readText":"i\u017c ra`\u0101 n\u0101ran fa q\u0101la li`ahlihimku\u1e61\u016b inn\u012b \u0101nastu n\u0101ral la'all\u012b \u0101t\u012bkum min-h\u0101 biqabasin au ajidu 'alan-n\u0101ri hud\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020010.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":11,"ayahText":"\u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627\u0653 \u0627\u064e\u062a\u0670\u0649\u0647\u064e\u0627 \u0646\u064f\u0648\u0652\u062f\u0650\u064a\u064e \u064a\u0670\u0645\u064f\u0648\u0652\u0633\u0670\u0653\u0649 \u06d9","indoText":"Maka ketika dia mendatanginya (ke tempat api itu) dia dipanggil, \u201cWahai Musa!","enText":"And when he came to it, he was called, \"O Moses,","readText":"fa lamm\u0101 at\u0101h\u0101 n\u1ee5diya y\u0101 m\u1ee5s\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020011.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":12,"ayahText":"\u0627\u0650\u0646\u0651\u0650\u064a\u0652\u0653 \u0627\u064e\u0646\u064e\u0627\u06e0 \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0641\u064e\u0627\u062e\u0652\u0644\u064e\u0639\u0652 \u0646\u064e\u0639\u0652\u0644\u064e\u064a\u0652\u0643\u064e\u06da \u0627\u0650\u0646\u0651\u064e\u0643\u064e \u0628\u0650\u0627\u0644\u0652\u0648\u064e\u0627\u062f\u0650 \u0627\u0644\u0652\u0645\u064f\u0642\u064e\u062f\u0651\u064e\u0633\u0650 \u0637\u064f\u0648\u064b\u0649 \u06d7","indoText":"Sungguh, Aku adalah Tuhanmu, maka lepaskan kedua terompahmu. Karena sesungguhnya engkau berada di lembah yang suci, Tuwa.","enText":"Indeed, I am your Lord, so remove your sandals. Indeed, you are in the sacred valley of Tuwa.","readText":"inn\u012b an\u0101 rabbuka fakhla' na'la\u012bk, innaka bil-w\u0101dil-muqaddasi \u1e6duw\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020012.mp3","juz":16,"manzil":4,"page":312,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":13,"ayahText":"\u0648\u064e\u0627\u064e\u0646\u064e\u0627 \u0627\u062e\u0652\u062a\u064e\u0631\u0652\u062a\u064f\u0643\u064e \u0641\u064e\u0627\u0633\u0652\u062a\u064e\u0645\u0650\u0639\u0652 \u0644\u0650\u0645\u064e\u0627 \u064a\u064f\u0648\u0652\u062d\u0670\u0649","indoText":" Dan Aku telah memilih engkau, maka dengarkanlah apa yang akan diwahyukan (kepadamu).","enText":"And I have chosen you, so listen to what is revealed [to you].","readText":"wa anakhtartuka fastami' lim\u0101 y\u1ee5\u1e25\u0101","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020013.mp3","juz":16,"manzil":4,"page":313,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":14,"ayahText":"\u0627\u0650\u0646\u0651\u064e\u0646\u0650\u064a\u0652\u0653 \u0627\u064e\u0646\u064e\u0627 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0644\u064e\u0627\u0653 \u0627\u0650\u0644\u0670\u0647\u064e \u0627\u0650\u0644\u0651\u064e\u0627\u0653 \u0627\u064e\u0646\u064e\u0627\u06e0 \u0641\u064e\u0627\u0639\u0652\u0628\u064f\u062f\u0652\u0646\u0650\u064a\u0652\u06d9 \u0648\u064e\u0627\u064e\u0642\u0650\u0645\u0650 \u0627\u0644\u0635\u0651\u064e\u0644\u0670\u0648\u0629\u064e \u0644\u0650\u0630\u0650\u0643\u0652\u0631\u0650\u064a\u0652","indoText":" Sungguh, Aku ini Allah, tidak ada tuhan selain Aku, maka sembahlah Aku dan laksanakanlah salat untuk mengingat Aku.","enText":"Indeed, I am Allah. There is no deity except Me, so worship Me and establish prayer for My remembrance.","readText":"innan\u012b anall\u0101hu l\u0101 il\u0101ha ill\u0101 ana fa'budn\u012b wa aqimi\u1e63-\u1e63al\u0101ta li\u017cikr\u012b","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/020014.mp3","juz":16,"manzil":4,"page":313,"ruku":270,"hizbQuarter":125,"sajda":false},{"verseId":15,"ayahText":"\u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u064e \u0627\u0670\u062a\u0650\u064a\u064e\u0629\u064c \u0627\u064e\u0643\u064e\u0627\u062f\u064f \u0627\u064f\u062e\u0652\u0641\u0650\u064a\u0652\u0647\u064e\u0627 \u0644\u0650\u062a\u064f\u062c\u0652\u0632\u0670\u0649 \u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u0652\u0633\u064d\u06e2 \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0633\u0652\u0639\u0670\u0649","indoText":"Sungguh, hari Kiamat itu akan datang, Aku merahasiakan (waktunya) agar setiap orang dibalas sesuai dengan apa yang telah dia usahakan.","enText":"Indeed, the Hour is coming - I almost conceal it - so that every soul may be recompensed according to that for which it strives.","readT