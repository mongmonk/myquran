\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010031.mp3","juz":11,"manzil":3,"page":212,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":32,"ayahText":"\u0641\u064e\u0630\u0670\u0644\u0650\u0643\u064f\u0645\u064f \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0643\u064f\u0645\u064f \u0627\u0644\u0652\u062d\u064e\u0642\u0651\u064f\u06da \u0641\u064e\u0645\u064e\u0627\u0630\u064e\u0627 \u0628\u064e\u0639\u0652\u062f\u064e \u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0627\u0650\u0644\u0651\u064e\u0627 \u0627\u0644\u0636\u0651\u064e\u0644\u0670\u0644\u064f \u06d6\u0641\u064e\u0627\u064e\u0646\u0651\u0670\u0649 \u062a\u064f\u0635\u0652\u0631\u064e\u0641\u064f\u0648\u0652\u0646\u064e","indoText":"Maka itulah Allah, Tuhan kamu yang sebenarnya; maka tidak ada setelah kebenaran itu melainkan kesesatan. Maka mengapa kamu berpaling (dari kebenaran)?","enText":"For that is Allah, your Lord, the Truth. And what can be beyond truth except error? So how are you averted?","readText":"fa \u017c\u0101likumull\u0101hu rabbukumul-\u1e25aqq, fa m\u0101\u017c\u0101 ba'dal-\u1e25aqqi illa\u1e0d-\u1e0dal\u0101lu fa ann\u0101 tu\u1e63raf\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010032.mp3","juz":11,"manzil":3,"page":212,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":33,"ayahText":"\u0643\u064e\u0630\u0670\u0644\u0650\u0643\u064e \u062d\u064e\u0642\u0651\u064e\u062a\u0652 \u0643\u064e\u0644\u0650\u0645\u064e\u062a\u064f \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0639\u064e\u0644\u064e\u0649 \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0641\u064e\u0633\u064e\u0642\u064f\u0648\u0652\u0653\u0627 \u0627\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u0644\u064e\u0627 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0652\u0646\u064e","indoText":"Demikianlah telah tetap (hukuman) Tuhanmu terhadap orang-orang yang fasik, karena sesungguhnya mereka tidak beriman.","enText":"Thus the word of your Lord has come into effect upon those who defiantly disobeyed - that they will not believe.","readText":"ka\u017c\u0101lika \u1e25aqqat kalimatu rabbika 'alalla\u017c\u012bna fasaq\u016b annahum l\u0101 yu`min\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010033.mp3","juz":11,"manzil":3,"page":212,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":34,"ayahText":"\u0642\u064f\u0644\u0652 \u0647\u064e\u0644\u0652 \u0645\u0650\u0646\u0652 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u06e4\u0649\u0655\u0650\u0643\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u064a\u0651\u064e\u0628\u0652\u062f\u064e\u0624\u064f\u0627 \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u064e \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0639\u0650\u064a\u0652\u062f\u064f\u0647\u0657\u06d7 \u0642\u064f\u0644\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u064a\u064e\u0628\u0652\u062f\u064e\u0624\u064f\u0627 \u0627\u0644\u0652\u062e\u064e\u0644\u0652\u0642\u064e \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0639\u0650\u064a\u0652\u062f\u064f\u0647\u0657 \u0641\u064e\u0627\u064e\u0646\u0651\u0670\u0649 \u062a\u064f\u0624\u0652\u0641\u064e\u0643\u064f\u0648\u0652\u0646\u064e","indoText":"Katakanlah, \u201cAdakah di antara sekutumu yang dapat memulai penciptaan (makhluk), kemudian mengulanginya (menghidupkannya) kembali?\u201d Katakanlah, \u201cAllah memulai (penciptaan) makhluk, kemudian mengulanginya. Maka bagaimana kamu dipalingkan (menyembah selain Allah)?\u201d","enText":"Say, \"Are there of your 'partners' any who begins creation and then repeats it?\" Say, \"Allah begins creation and then repeats it, so how are you deluded?\"","readText":"qul hal min syurak\u0101`ikum may yabda`ul-khalqa \u1e61umma yu'\u012bduh, qulill\u0101hu yabda`ul-khalqa \u1e61umma yu'\u012bduh\u1ee5 fa ann\u0101 tu`fak\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010034.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":35,"ayahText":"\u0642\u064f\u0644\u0652 \u0647\u064e\u0644\u0652 \u0645\u0650\u0646\u0652 \u0634\u064f\u0631\u064e\u0643\u064e\u0627\u06e4\u0649\u0655\u0650\u0643\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u064a\u0651\u064e\u0647\u0652\u062f\u0650\u064a\u0653\u0652 \u0627\u0650\u0644\u064e\u0649 \u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650\u06d7 \u0642\u064f\u0644\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u064f \u064a\u064e\u0647\u0652\u062f\u0650\u064a\u0652 \u0644\u0650\u0644\u0652\u062d\u064e\u0642\u0651\u0650\u06d7 \u0627\u064e\u0641\u064e\u0645\u064e\u0646\u0652 \u064a\u0651\u064e\u0647\u0652\u062f\u0650\u064a\u0652\u0653 \u0627\u0650\u0644\u064e\u0649 \u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0627\u064e\u062d\u064e\u0642\u0651\u064f \u0627\u064e\u0646\u0652 \u064a\u0651\u064f\u062a\u0651\u064e\u0628\u064e\u0639\u064e \u0627\u064e\u0645\u0651\u064e\u0646\u0652 \u0644\u0651\u064e\u0627 \u064a\u064e\u0647\u0650\u062f\u0651\u0650\u064a\u0652\u0653 \u0627\u0650\u0644\u0651\u064e\u0627\u0653 \u0627\u064e\u0646\u0652 \u064a\u0651\u064f\u0647\u0652\u062f\u0670\u0649\u06da \u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0643\u064f\u0645\u0652\u06d7 \u0643\u064e\u064a\u0652\u0641\u064e \u062a\u064e\u062d\u0652\u0643\u064f\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"Katakanlah, \u201cApakah di antara sekutumu ada yang membimbing kepada kebenaran?\u201d Katakanlah, \u201cAllah-lah yang membimbing kepada kebenaran.\u201d Maka manakah yang lebih berhak diikuti, Tuhan yang membimbing kepada kebenaran itu, ataukah orang yang tidak mampu membimbing bahkan perlu dibimbing? Maka mengapa kamu (berbuat demikian)? Bagaimanakah kamu mengambil keputusan?","enText":"Say, \"Are there of your 'partners' any who guides to the truth?\" Say, \"Allah guides to the truth. So is He who guides to the truth more worthy to be followed or he who guides not unless he is guided? Then what is [wrong] with you - how do you judge?\"","readText":"qul hal min syurak\u0101`ikum may yahd\u012b ilal-\u1e25aqq, qulill\u0101hu yahd\u012b lil-\u1e25aqq, a fa may yahd\u012b ilal-\u1e25aqqi a\u1e25aqqu ay yuttaba'a am mal l\u0101 yahidd\u012b ill\u0101 ay yuhd\u0101, fa m\u0101 lakum, kaifa ta\u1e25kum\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010035.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":36,"ayahText":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f \u0627\u064e\u0643\u0652\u062b\u064e\u0631\u064f\u0647\u064f\u0645\u0652 \u0627\u0650\u0644\u0651\u064e\u0627 \u0638\u064e\u0646\u0651\u064b\u0627\u06d7 \u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u0652\u0646\u0650\u064a\u0652 \u0645\u0650\u0646\u064e \u0627\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u0652\u0640\u0654\u064b\u0627\u06d7 \u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0639\u064e\u0644\u0650\u064a\u0652\u0645\u064c \u06e2\u0628\u0650\u0645\u064e\u0627 \u064a\u064e\u0641\u0652\u0639\u064e\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dan kebanyakan mereka hanya mengikuti dugaan. Sesungguhnya dugaan itu tidak sedikit pun berguna untuk melawan kebenaran. Sungguh, Allah Maha Mengetahui apa yang mereka kerjakan.","enText":"And most of them follow not except assumption. Indeed, assumption avails not against the truth at all. Indeed, Allah is Knowing of what they do.","readText":"wa m\u0101 yattabi'u ak\u1e61aruhum ill\u0101 \u1e93ann\u0101, inna\u1e93-\u1e93anna l\u0101 yugn\u012b minal-\u1e25aqqi syai`\u0101, innall\u0101ha 'al\u012bmum bim\u0101 yaf'al\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010036.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":37,"ayahText":"\u0648\u064e\u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064e \u0647\u0670\u0630\u064e\u0627 \u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0627\u0670\u0646\u064f \u0627\u064e\u0646\u0652 \u064a\u0651\u064f\u0641\u0652\u062a\u064e\u0631\u0670\u0649 \u0645\u0650\u0646\u0652 \u062f\u064f\u0648\u0652\u0646\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0648\u064e\u0644\u0670\u0643\u0650\u0646\u0652 \u062a\u064e\u0635\u0652\u062f\u0650\u064a\u0652\u0642\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652 \u0628\u064e\u064a\u0652\u0646\u064e \u064a\u064e\u062f\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u062a\u064e\u0641\u0652\u0635\u0650\u064a\u0652\u0644\u064e \u0627\u0644\u0652\u0643\u0650\u062a\u0670\u0628\u0650 \u0644\u064e\u0627 \u0631\u064e\u064a\u0652\u0628\u064e \u0641\u0650\u064a\u0652\u0647\u0650 \u0645\u0650\u0646\u0652 \u0631\u0651\u064e\u0628\u0651\u0650 \u0627\u0644\u0652\u0639\u0670\u0644\u064e\u0645\u0650\u064a\u0652\u0646\u064e\u06d7","indoText":"Dan tidak mungkin Al-Qur'an ini dibuat-buat oleh selain Allah; tetapi (Al-Qur'an) membenarkan (kitab-kitab) yang sebelumnya dan menjelaskan hukum-hukum yang telah ditetapkannya, tidak ada keraguan di dalamnya, (diturunkan) dari Tuhan seluruh alam.","enText":"And it was not [possible] for this Qur'an to be produced by other than Allah, but [it is] a confirmation of what was before it and a detailed explanation of the [former] Scripture, about which there is no doubt, from the Lord of the worlds.","readText":"wa m\u0101 k\u0101na h\u0101\u017cal-qur`\u0101nu ay yuftar\u0101 min d\u1ee5nill\u0101hi wa l\u0101kin ta\u1e63d\u012bqalla\u017c\u012b baina yadaihi wa taf\u1e63\u012blal-kit\u0101bi l\u0101 raiba f\u012bhi mir rabbil-'\u0101lam\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010037.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":38,"ayahText":"\u0627\u064e\u0645\u0652 \u064a\u064e\u0642\u064f\u0648\u0652\u0644\u064f\u0648\u0652\u0646\u064e \u0627\u0641\u0652\u062a\u064e\u0631\u0670\u0649\u0647\u064f \u06d7 \u0642\u064f\u0644\u0652 \u0641\u064e\u0623\u0652\u062a\u064f\u0648\u0652\u0627 \u0628\u0650\u0633\u064f\u0648\u0652\u0631\u064e\u0629\u064d \u0645\u0651\u0650\u062b\u0652\u0644\u0650\u0647\u0656 \u0648\u064e\u0627\u062f\u0652\u0639\u064f\u0648\u0652\u0627 \u0645\u064e\u0646\u0650 \u0627\u0633\u0652\u062a\u064e\u0637\u064e\u0639\u0652\u062a\u064f\u0645\u0652 \u0645\u0650\u0651\u0646\u0652 \u062f\u064f\u0648\u0652\u0646\u0650 \u0627\u0644\u0644\u0651\u0670\u0647\u0650 \u0627\u0650\u0646\u0652 \u0643\u064f\u0646\u0652\u062a\u064f\u0645\u0652 \u0635\u0670\u062f\u0650\u0642\u0650\u064a\u0652\u0646\u064e","indoText":"Apakah pantas mereka mengatakan dia (Muhammad) yang telah membuat-buatnya? Katakanlah, \u201cBuatlah sebuah surah yang semisal dengan surah (Al-Qur'an), dan ajaklah siapa saja di antara kamu orang yang mampu (membuatnya) selain Allah, jika kamu orang-orang yang benar.\u201d","enText":"Or do they say [about the Prophet], \"He invented it?\" Say, \"Then bring forth a surah like it and call upon [for assistance] whomever you can besides Allah, if you should be truthful.\"","readText":"am yaq\u1ee5l\u1ee5naftar\u0101h, qul fa`t\u1ee5 bis\u1ee5ratim mi\u1e61lih\u012b wad'\u1ee5 manista\u1e6da'tum min d\u1ee5nill\u0101hi ing kuntum \u1e63\u0101diq\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010038.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":39,"ayahText":"\u0628\u064e\u0644\u0652 \u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0652\u0627 \u0628\u0650\u0645\u064e\u0627 \u0644\u064e\u0645\u0652 \u064a\u064f\u062d\u0650\u064a\u0652\u0637\u064f\u0648\u0652\u0627 \u0628\u0650\u0639\u0650\u0644\u0652\u0645\u0650\u0647\u0656 \u0648\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u064a\u064e\u0623\u0652\u062a\u0650\u0647\u0650\u0645\u0652 \u062a\u064e\u0623\u0652\u0648\u0650\u064a\u0652\u0644\u064f\u0647\u0657\u06d7 \u0643\u064e\u0630\u0670\u0644\u0650\u0643\u064e \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0627\u0644\u0651\u064e\u0630\u0650\u064a\u0652\u0646\u064e \u0645\u0650\u0646\u0652 \u0642\u064e\u0628\u0652\u0644\u0650\u0647\u0650\u0645\u0652 \u0641\u064e\u0627\u0646\u0652\u0638\u064f\u0631\u0652 \u0643\u064e\u064a\u0652\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0627\u0642\u0650\u0628\u064e\u0629\u064f \u0627\u0644\u0638\u0651\u0670\u0644\u0650\u0645\u0650\u064a\u0652\u0646\u064e","indoText":"Bahkan (yang sebenarnya), mereka mendustakan apa yang mereka belum mengetahuinya dengan sempurna dan belum mereka peroleh penjelasannya. Demikianlah halnya umat-umat yang ada sebelum mereka telah mendustakan (rasul). Maka perhatikanlah bagaimana akibat orang yang zalim.","enText":"Rather, they have denied that which they encompass not in knowledge and whose interpretation has not yet come to them. Thus did those before them deny. Then observe how was the end of the wrongdoers.","readText":"bal ka\u017c\u017cab\u1ee5 bim\u0101 lam yu\u1e25\u012b\u1e6d\u1ee5 bi'ilmih\u012b wa lamm\u0101 ya`tihim ta`w\u012bluh, ka\u017c\u0101lika ka\u017c\u017caballa\u017c\u012bna ming qablihim fan\u1e93ur kaifa k\u0101na '\u0101qibatu\u1e93-\u1e93\u0101lim\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010039.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":40,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u064a\u0651\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0647\u0656 \u0648\u064e\u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u0644\u0651\u064e\u0627 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f \u0628\u0650\u0647\u0656\u06d7 \u0648\u064e\u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0627\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0628\u0650\u0627\u0644\u0652\u0645\u064f\u0641\u0652\u0633\u0650\u062f\u0650\u064a\u0652\u0646\u064e","indoText":"Dan di antara mereka ada orang-orang yang beriman kepadanya (Al-Qur'an), dan di antaranya ada (pula) orang-orang yang tidak beriman kepadanya. Sedangkan Tuhanmu lebih mengetahui tentang orang-orang yang berbuat kerusakan.","enText":"And of them are those who believe in it, and of them are those who do not believe in it. And your Lord is most knowing of the corrupters","readText":"wa min-hum may yu`minu bih\u012b wa min-hum mal l\u0101 yu`minu bih, wa rabbuka a'lamu bil-mufsid\u012bn","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010040.mp3","juz":11,"manzil":3,"page":213,"ruku":175,"hizbQuarter":85,"sajda":false},{"verseId":41,"ayahText":"\u0648\u064e\u0627\u0650\u0646\u0652 \u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0652\u0643\u064e \u0641\u064e\u0642\u064f\u0644\u0652 \u0644\u0651\u0650\u064a\u0652 \u0639\u064e\u0645\u064e\u0644\u0650\u064a\u0652 \u0648\u064e\u0644\u064e\u0643\u064f\u0645\u0652 \u0639\u064e\u0645\u064e\u0644\u064f\u0643\u064f\u0645\u0652\u06da \u0627\u064e\u0646\u0652\u062a\u064f\u0645\u0652 \u0628\u064e\u0631\u0650\u064a\u06e4\u0652\u0640\u0654\u064f\u0648\u0652\u0646\u064e \u0645\u0650\u0645\u0651\u064e\u0627\u0653 \u0627\u064e\u0639\u0652\u0645\u064e\u0644\u064f \u0648\u064e\u0627\u064e\u0646\u064e\u0627\u06e0 \u0628\u064e\u0631\u0650\u064a\u06e4\u0652\u0621\u064c \u0645\u0650\u0651\u0645\u0651\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dan jika mereka (tetap) mendustakanmu (Muhammad), maka katakanlah, \u201cBagiku pekerjaanku dan bagimu pekerjaanmu. Kamu tidak bertanggung jawab terhadap apa yang aku kerjakan dan aku pun tidak bertanggung jawab terhadap apa yang kamu kerjakan.\u201d","enText":"And if they deny you, [O Muhammad], then say, \"For me are my deeds, and for you are your deeds. You are disassociated from what I do, and I am disassociated from what you do.\"","readText":"wa ing ka\u017c\u017cab\u1ee5ka fa qul l\u012b 'amal\u012b wa lakum 'amalukum, antum bar\u012b`\u1ee5na mimm\u0101 a'malu wa ana bar\u012b`um mimm\u0101 ta'mal\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010041.mp3","juz":11,"manzil":3,"page":213,"ruku":176,"hizbQuarter":85,"sajda":false},{"verseId":42,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u064a\u0651\u064e\u0633\u0652\u062a\u064e\u0645\u0650\u0639\u064f\u0648\u0652\u0646\u064e \u0627\u0650\u0644\u064e\u064a\u0652\u0643\u064e\u06d7 \u0627\u064e\u0641\u064e\u0627\u064e\u0646\u0652\u062a\u064e \u062a\u064f\u0633\u0652\u0645\u0650\u0639\u064f \u0627\u0644\u0635\u0651\u064f\u0645\u0651\u064e \u0648\u064e\u0644\u064e\u0648\u0652 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0644\u064e\u0627 \u064a\u064e\u0639\u0652\u0642\u0650\u0644\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara mereka ada yang mendengarkan engkau (Muhammad). Tetapi apakah engkau dapat menjadikan orang yang tuli itu mendengar walaupun mereka tidak mengerti?","enText":"And among them are those who listen to you. But can you cause the deaf to hear, although they will not use reason?","readText":"wa min-hum may yastami'\u1ee5na ila\u012bk, a fa anta tusmi'u\u1e63-\u1e63umma walau k\u0101n\u1ee5 l\u0101 ya'qil\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010042.mp3","juz":11,"manzil":3,"page":213,"ruku":176,"hizbQuarter":85,"sajda":false},{"verseId":43,"ayahText":"\u0648\u064e\u0645\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u0645\u0651\u064e\u0646\u0652 \u064a\u0651\u064e\u0646\u0652\u0638\u064f\u0631\u064f \u0627\u0650\u0644\u064e\u064a\u0652\u0643\u064e\u06d7 \u0627\u064e\u0641\u064e\u0627\u064e\u0646\u0652\u062a\u064e \u062a\u064e\u0647\u0652\u062f\u0650\u0649 \u0627\u0644\u0652\u0639\u064f\u0645\u0652\u064a\u064e \u0648\u064e\u0644\u064e\u0648\u0652 \u0643\u064e\u0627\u0646\u064f\u0648\u0652\u0627 \u0644\u064e\u0627 \u064a\u064f\u0628\u0652\u0635\u0650\u0631\u064f\u0648\u0652\u0646\u064e","indoText":"Dan di antara mereka ada yang melihat kepada engkau. Tetapi apakah engkau dapat memberi petunjuk kepada orang yang buta, walaupun mereka tidak memperhatikan?","enText":"And among them are those who look at you. But can you guide the blind although they will not [attempt to] see?","readText":"wa min-hum may yan\u1e93uru ila\u012bk, a fa anta tahdil-'umya walau k\u0101n\u1ee5 l\u0101 yub\u1e63ir\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010043.mp3","juz":11,"manzil":3,"page":214,"ruku":176,"hizbQuarter":85,"sajda":false},{"verseId":44,"ayahText":"\u0627\u0650\u0646\u0651\u064e \u0627\u0644\u0644\u0651\u0670\u0647\u064e \u0644\u064e\u0627 \u064a\u064e\u0638\u0652\u0644\u0650\u0645\u064f \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u0634\u064e\u064a\u0652\u0640\u0654\u064b\u0627 \u0648\u0651\u064e\u0644\u0670\u0643\u0650\u0646\u0651\u064e \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u0627\u064e\u0646\u0652\u0641\u064f\u0633\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0638\u0652\u0644\u0650\u0645\u064f\u0648\u0652\u0646\u064e","indoText":"Sesungguhnya Allah tidak menzalimi manusia sedikit pun, tetapi manusia itulah yang menzalimi dirinya sendiri.","enText":"Indeed, Allah does not wrong the people at all, but it is the people who are wronging themselves.","readText":"innall\u0101ha l\u0101 ya\u1e93limun-n\u0101sa syai`aw wa l\u0101kinnan-n\u0101sa anfusahum ya\u1e93lim\u1ee5n","audio":"https:\/\/everyayah.com\/data\/Alafasy_64kbps\/010044.mp3","juz":11,"manzil":3,"page":214,"ruku":176,"hizbQuarter":85,"sajda":false},{"verseId":45,"ayahText":"\u0648\u064e\u064a\u064e\u0648\u0652\u0645\u064e \u064a\u064e\u062d\u0652\u0634\u064f\u0631\u064f\u0647\u064f\u0645\u0652 \u0643\u064e\u0627\u064e\u0646\u0652 \u0644\u0651\u064e\u0645\u0652 \u064a\u064e\u0644\u0652\u0628\u064e\u062b\u064f\u0648\u0652\u0653\u0627 \u0627\u0650\u0644\u0651\u064e\u0627 \u0633\u064e\u0627\u0639\u064e\u0629\u064b \u0645\u0650\u0651\u0646\u064e \u0627\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u0650 \u064a\u064e\u062a\u064e\u0639\u064e\u0627\u0631\u064e\u0641\u064f\u0648\u0652\u0646\u064e \u0628\u064e\u064a\u0652\u0646\u064e\u0647\u064f\u0645\u0652